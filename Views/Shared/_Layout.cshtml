                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 7h16" />
                            <path d="M4 12h16" />
                            <path d="M4 17h16" />
                        </svg>
                    </span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-3 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @(IsActive("Home", "Index") ? "nav-link--active" : string.Empty)" asp-controller="Home" asp-action="Index" asp-fragment="kham-pha"><span class="nav-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg></span>Khám phá</a></li>
                        <li class="nav-item"><a class="nav-link @(IsControllerActive("Tours") ? "nav-link--active" : string.Empty)" asp-controller="Tours" asp-action="Index"><span class="nav-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Z" /><path d="M9 3v15" /><path d="M15 6v15" /></svg></span>Danh sách tour</a></li>
                        <li class="nav-item"><a class="nav-link @(IsControllerActive("Promotions") ? "nav-link--active" : string.Empty)" asp-controller="Promotions" asp-action="Index"><span class="nav-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" /><path d="M7.5 7.5h.01" /></svg></span>Ưu đãi</a></li>
                        <li class="nav-item"><a class="nav-link @(IsControllerActive("Guides") ? "nav-link--active" : string.Empty)" asp-controller="Guides" asp-action="Index"><span class="nav-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 7v14" /><path d="M3 18a2 2 0 0 0 2 2h7V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12Z" /><path d="M21 18a2 2 0 0 1-2 2h-7V6a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v12Z" /></svg></span>Cẩm nang</a></li>
                        <li class="nav-item"><a class="nav-link @(IsActive("Home", "Contact") ? "nav-link--active" : string.Empty)" asp-controller="Home" asp-action="Contact"><span class="nav-link__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.7.6 2.5a2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6.5 6.5l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.6.5 2.5.6A2 2 0 0 1 22 16.9Z" /></svg></span>Liên hệ</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="mailbox-link" asp-controller="Account" asp-action="Inbox" aria-label="Thông báo" title="Thông báo" data-notification-link data-notification-count="@unreadNotificationCount">
                                <span class="mailbox-link__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" focusable="false">
                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                        <path d="M10 21h4" />
                                    </svg>
                                </span>
                                <span class="mailbox-link__badge @(unreadNotificationCount > 0 ? string.Empty : "is-hidden")" data-notification-badge>@unreadNotificationCount</span>
                            </a>
                            @if (User.IsInRole(RoleConstants.Customer))
                            {
                                <a class="wishlist-nav-link @(IsActive("Account", "Wishlist") ? "wishlist-nav-link--active" : string.Empty)" asp-controller="Account" asp-action="Wishlist" aria-label="Tour yêu thích" data-wishlist-nav data-wishlist-count="@wishlistCount">
