                                    <span class="account-menu__name">@User.Identity.Name</span>
                                    <span class="account-menu__chevron" aria-hidden="true">⌄</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end account-dropdown">
                                    @if (User.IsInRole(RoleConstants.Customer))
                                    {
                                        <a class="account-dropdown__item" asp-controller="Account" asp-action="Bookings">
                                            <span class="account-dropdown__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" focusable="false">
                                                    <path d="M8 6h13" />
                                                    <path d="M8 12h13" />
                                                    <path d="M8 18h13" />
                                                    <path d="M3 6h.01" />
                                                    <path d="M3 12h.01" />
                                                    <path d="M3 18h.01" />
                                                </svg>
                                            </span>
                                            <span>
                                                <strong>Đơn của tôi</strong>
                                                <small>Theo dõi booking, thanh toán và hợp đồng</small>
                                            </span>
                                        </a>
                                    }
                                    @if (RoleConstants.BackOffice.Any(User.IsInRole))
                                    {
                                        <a class="account-dropdown__item" asp-controller="Admin" asp-action="Index">
                                            <span class="account-dropdown__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" focusable="false">
                                                    <path d="M4 13h6V4H4v9Z" />
                                                    <path d="M14 20h6V4h-6v16Z" />
                                                    <path d="M4 20h6v-3H4v3Z" />
                                                </svg>
                                            </span>
                                            <span>
                                                <strong>Quản trị</strong>
                                                <small>Mở trang quản lý hệ thống</small>
                                            </span>
                                        </a>
                                    }
                                    <a class="account-dropdown__item" asp-controller="Account" asp-action="Profile">
                                        <span class="account-dropdown__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M20 21a8 8 0 0 0-16 0" />
                                                <path d="M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
                                            </svg>
                                        </span>
                                        <span>
                                            <strong>Profile</strong>
                                            <small>Cập nhật thông tin và đổi mật khẩu</small>
                                        </span>
                                    </a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="account-dropdown__form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="account-dropdown__item account-dropdown__button">
                                            <span class="account-dropdown__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" focusable="false">
                                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                                    <path d="M16 17l5-5-5-5" />
                                                    <path d="M21 12H9" />
                                                </svg>
                                            </span>
                                            <span>
                                                <strong>Đăng xuất</strong>
                                                <small>Thoát khỏi tài khoản hiện tại</small>
                                            </span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            @if (User.IsInRole(RoleConstants.Customer))
                            {
                                <a class="btn btn-primary nav-cta nav-cta--booking" asp-controller="Tours" asp-action="Index">
                                    <span class="nav-cta__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 16 22 3l-7 19-4-8-9 2Z" /><path d="m22 3-11 11" /></svg></span>
                                    Đặt tour ngay
                                </a>
                            }
                        }
                        else
                        {
                            <a class="btn btn-link nav-action" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-primary nav-cta" asp-controller="Account" asp-action="Register">
                                <span class="nav-cta__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 16 22 3l-7 19-4-8-9 2Z" /><path d="m22 3-11 11" /></svg></span>
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

