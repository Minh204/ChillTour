    </footer>
    <div class="floating-contact-stack" data-floating-chat aria-label="Liên hệ nhanh">
        <div class="floating-contact-options" data-floating-chat-options>
            <a class="floating-zalo-link floating-contact-option" href="https://id.zalo.me/" target="_blank" rel="noopener noreferrer" aria-label="Mở Zalo">
                <span>Zalo</span>
            </a>
            <button type="button" class="floating-ai-link floating-contact-option" data-chatbot-open aria-label="Mở chatbot ChillTour">
                <span>AI</span>
            </button>
        </div>
        <button type="button" class="floating-chat-toggle" data-floating-chat-toggle aria-expanded="false" aria-label="Mở liên hệ nhanh">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                <path d="M8 10h8" />
                <path d="M8 14h5" />
            </svg>
            <span>Chat</span>
        </button>
    </div>

    <section class="chatbot-widget" data-chatbot-widget aria-live="polite" aria-hidden="true">
        <div class="chatbot-widget__head">
            <div>
                <span>ChillTour AI</span>
                <strong>Tư vấn tour nhanh</strong>
            </div>
            <button type="button" data-chatbot-close aria-label="Đóng chatbot">×</button>
        </div>
        <div class="chatbot-widget__messages" data-chatbot-messages>
            <div class="chatbot-message chatbot-message--bot">
                Xin chào, tôi có thể tư vấn tour theo điểm đến, ngày đi, số người và ngân sách. Bạn muốn đi đâu?
            </div>
        </div>
        <form class="chatbot-widget__form" data-chatbot-form>
            <input type="text" data-chatbot-input maxlength="600" placeholder="Nhập nhu cầu của bạn..." autocomplete="off" />
            <button type="submit">Gửi</button>
        </form>
    </section>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.8/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (appToasts.Count > 0)
    {
        <script>
            (() => {
                const toasts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appToasts));
                toasts.forEach((toast) => window.toastr?.[toast.Type]?.(toast.Message, toast.Title));
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private bool IsControllerActive(string controller)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActive(string controller, string action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
               && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }
}

