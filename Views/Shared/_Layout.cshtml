@using ChillTour.Data
@using ChillTour.Security
@using System.Security.Claims
@inject ChillTourDbContext DbContext
@{
    var currentUserIdRaw = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var hasCurrentUserId = long.TryParse(currentUserIdRaw, out var currentUserId);
    var unreadNotificationCount = 0;
    var wishlistCount = 0;

    if (User.Identity?.IsAuthenticated == true && hasCurrentUserId)
    {
        unreadNotificationCount = DbContext.Notifications.Count(x => x.UserId == currentUserId && !x.IsRead && !x.IsDeleted);
        if (User.IsInRole(RoleConstants.Customer))
        {
            wishlistCount = DbContext.Wishlists.Count(x => x.UserId == currentUserId);
        }
    }

    var appToastKeys = new[]
    {
        ("SuccessMessage", "success", "Thành công"),
        ("ErrorMessage", "error", "Không thể xử lý"),
        ("TourSuccessMessage", "success", "Thành công"),
        ("TourErrorMessage", "error", "Không thể xử lý"),
        ("PaymentInfoMessage", "info", "Thông báo"),
        ("PaymentErrorMessage", "error", "Không thể xử lý"),
        ("BookingSuccessMessage", "success", "Thành công"),
        ("BookingErrorMessage", "error", "Không thể xử lý"),
        ("WishlistSuccessMessage", "success", "Danh sách yêu thích"),
        ("ProfileSuccessMessage", "success", "Thành công"),
        ("PromotionSuccessMessage", "success", "Thành công"),
        ("PromotionErrorMessage", "error", "Không thể xử lý"),
        ("ContactSuccessMessage", "success", "Thành công"),
        ("ContractInfoMessage", "info", "Thông báo"),
        ("ContractErrorMessage", "error", "Không thể xử lý")
    };
    var appToasts = appToastKeys
        .Select(x => new { Message = TempData[x.Item1] as string, Type = x.Item2, Title = x.Item3 })
        .Where(x => !string.IsNullOrWhiteSpace(x.Message))
        .ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChillTour</title>
    <meta name="description" content="ChillTour - nền tảng đặt tour du lịch hiện đại, săn ưu đãi nhanh và lên lịch trình dễ dàng." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChillTour.styles.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
</head>
<body>
