@model ChillTour.Models.Tours.TourListViewModel
@{
    ViewData["Title"] = "Danh sách tour";
}

@section Styles {
    <link rel="stylesheet" href="~/pages/tours/tours.css" asp-append-version="true" />
}

<section class="tour-list-page">
    <div class="container">
        <div class="tour-list-hero" data-reveal>
            <div>
                <span class="eyebrow">Danh sách tour</span>
                <h1>Chọn hành trình phù hợp cho chuyến đi tiếp theo</h1>

                <form method="get" class="tour-list-toolbar">
                    <label>
                        <span>Từ khóa</span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tên tour, mã tour, điểm đến..." />
                    </label>

                    <label>
                        <span>Điểm đến</span>
                        <select name="destinationId" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var item in Model.DestinationOptions)
                            {
                                <option value="@item.Id" selected="@(Model.SelectedDestinationId == item.Id)">@item.Name</option>
                            }
                        </select>
                    </label>

                    <label>
                        <span>Danh mục</span>
                        <select name="categoryId" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var item in Model.CategoryOptions)
                            {
                                <option value="@item.Id" selected="@(Model.SelectedCategoryId == item.Id)">@item.Name</option>
                            }
                        </select>
                    </label>

                    <label>
                        <span>Ngày khởi hành</span>
                        <input type="date" name="departureDate" value="@(Model.SelectedDepartureDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </label>

                    <label>
                        <span>Ngân sách</span>
                        <select name="budgetRange" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="under-5" selected="@(Model.SelectedBudgetRange == "under-5")">Dưới 5 triệu</option>
                            <option value="5-10" selected="@(Model.SelectedBudgetRange == "5-10")">5 - 10 triệu</option>
                            <option value="10-20" selected="@(Model.SelectedBudgetRange == "10-20")">10 - 20 triệu</option>
                            <option value="over-20" selected="@(Model.SelectedBudgetRange == "over-20")">Trên 20 triệu</option>
                        </select>
                    </label>

                    <label>
                        <span>Sắp xếp</span>
                        <select name="sortBy" class="form-select">
                            <option value="">Mặc định</option>
                            <option value="price-asc" selected="@(Model.SelectedSortBy == "price-asc")">Giá tăng dần</option>
                            <option value="price-desc" selected="@(Model.SelectedSortBy == "price-desc")">Giá giảm dần</option>
                            <option value="rating-desc" selected="@(Model.SelectedSortBy == "rating-desc")">Sao cao nhất</option>
                        </select>
                    </label>

                    <label>
                        <span>Trạng thái lịch gần</span>
                        <select name="urgencyFilter" class="form-select">
                            <option value="" selected="@string.IsNullOrWhiteSpace(Model.SelectedUrgencyFilter)">Tất cả</option>
                            <option value="last-minute" selected="@(Model.SelectedUrgencyFilter == "last-minute")">Chỉ tour giờ chót</option>
                            <option value="regular" selected="@(Model.SelectedUrgencyFilter == "regular")">Không phải giờ chót</option>
                        </select>
                    </label>

                    <div class="hero-actions tour-list-toolbar__actions">
                        <button type="submit" class="btn btn-primary">Lọc kết quả</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SelectedDestinationId.HasValue || Model.SelectedCategoryId.HasValue || Model.SelectedDepartureDate.HasValue || !string.IsNullOrWhiteSpace(Model.SelectedBudgetRange) || !string.IsNullOrWhiteSpace(Model.SelectedSortBy) || !string.IsNullOrWhiteSpace(Model.SelectedUrgencyFilter))
                {
                    <div class="tour-list-filter-summary">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <span>Từ khóa: @Model.SearchTerm</span>
                        }
                        @if (Model.SelectedDestinationId.HasValue)
                        {
                            <span>Lọc theo điểm đến</span>
                        }
                        @if (Model.SelectedCategoryId.HasValue)
                        {
                            <span>Lọc theo danh mục</span>
                        }
                        @if (Model.SelectedDepartureDate.HasValue)
                        {
                            <span>Ngày đi: @Model.SelectedDepartureDate.Value.ToString("dd/MM/yyyy")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedBudgetRange))
                        {
                            <span>Ngân sách: @BudgetLabel(Model.SelectedBudgetRange)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedSortBy))
                        {
                            <span>Sắp xếp: @SortLabel(Model.SelectedSortBy)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedUrgencyFilter))
                        {
                            <span>Trạng thái: @UrgencyLabel(Model.SelectedUrgencyFilter)</span>
                        }
                    </div>
                }
            </div>

            <div class="tour-list-summary">
                <span>Tổng tour đang mở bán</span>
                <strong>@Model.TotalItems</strong>
            </div>
        </div>

        @if (Model.Tours.Count == 0)
        {
            <section class="tour-list-empty">
                <h2>Không có tour phù hợp</h2>
                <p>Hãy thử nới rộng bộ lọc hoặc quay lại trang này sau.</p>
            </section>
        }
        else
        {
            <section class="tour-list-grid">
                @foreach (var tour in Model.Tours)
                {
                    <article class="tour-list-card" data-reveal>
                        <a asp-controller="Tours" asp-action="Details" asp-route-slug="@tour.Slug" class="tour-list-card__media">
                            @if (!string.IsNullOrWhiteSpace(tour.ImageUrl))
                            {
                                <img src="@tour.ImageUrl" alt="@tour.TourName" class="tour-list-card__image" />
                            }
                            else
                            {
                                <div class="tour-list-card__placeholder">ChillTour</div>
                            }

                            <div class="tour-list-card__badges">
                                <span class="tour-list-card__code">@tour.TourCode</span>
                                @if (tour.IsFeatured)
                                {
                                    <span class="tour-list-card__featured">Nổi bật</span>
                                }
                            </div>
                        </a>

                        <div class="tour-list-card__body">
                            <div class="tour-list-card__meta">@tour.CategoryName</div>
                            <div class="tour-list-card__rating">
                                <span class="tour-list-card__stars">★</span>
                                <strong>@(tour.ReviewCount == 0 ? "Mới" : tour.AverageRating.ToString("0.0"))</strong>
                                <span>@(tour.ReviewCount == 0 ? "Chưa có đánh giá" : $"{tour.ReviewCount} đánh giá")</span>
                            </div>

                            @if (tour.IsLastMinute)
                            {
                                <div class="tour-list-card__flash">Giờ chót · khởi hành trong 5 ngày</div>
                            }

                            <h2>
                                <a asp-controller="Tours" asp-action="Details" asp-route-slug="@tour.Slug">@tour.TourName</a>
                            </h2>
                            <p class="tour-list-card__route">@tour.RouteName</p>
                            <p class="tour-list-card__desc">@(string.IsNullOrWhiteSpace(tour.ShortDescription) ? "Lịch trình đã được xuất bản. Xem chi tiết để biết thêm dịch vụ, hình ảnh và thông tin khởi hành." : tour.ShortDescription)</p>

                            <div class="tour-list-card__footer">
                                <div>
                                    <span>@tour.DurationDays ngày @tour.DurationNights đêm</span>
                                    <strong>@tour.BasePrice.ToString("N0") đ</strong>
                                </div>
                                <a asp-controller="Tours" asp-action="Details" asp-route-slug="@tour.Slug" class="btn btn-outline-primary">Xem chi tiết</a>
                            </div>
                        </div>
                    </article>
                }
            </section>

            @if (Model.TotalPages > 1)
            {
                <div class="tour-list-pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-destinationId="@Model.SelectedDestinationId" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-departureDate="@(Model.SelectedDepartureDate?.ToString("yyyy-MM-dd"))" asp-route-budgetRange="@Model.SelectedBudgetRange" asp-route-sortBy="@Model.SelectedSortBy" asp-route-urgencyFilter="@Model.SelectedUrgencyFilter" class="tour-list-pagination__link">Trước</a>
                    }
                    else
                    {
                        <span class="tour-list-pagination__link is-disabled">Trước</span>
                    }

                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a asp-action="Index" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.SearchTerm" asp-route-destinationId="@Model.SelectedDestinationId" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-departureDate="@(Model.SelectedDepartureDate?.ToString("yyyy-MM-dd"))" asp-route-budgetRange="@Model.SelectedBudgetRange" asp-route-sortBy="@Model.SelectedSortBy" asp-route-urgencyFilter="@Model.SelectedUrgencyFilter" class="tour-list-pagination__link @(pageNumber == Model.CurrentPage ? "is-active" : "")">@pageNumber</a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-destinationId="@Model.SelectedDestinationId" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-departureDate="@(Model.SelectedDepartureDate?.ToString("yyyy-MM-dd"))" asp-route-budgetRange="@Model.SelectedBudgetRange" asp-route-sortBy="@Model.SelectedSortBy" asp-route-urgencyFilter="@Model.SelectedUrgencyFilter" class="tour-list-pagination__link">Sau</a>
                    }
                    else
                    {
                        <span class="tour-list-pagination__link is-disabled">Sau</span>
                    }
                </div>
            }
        }
    </div>
</section>

@functions {
    private static string BudgetLabel(string? budgetRange) => budgetRange?.Trim().ToLowerInvariant() switch
    {
        "under-5" => "Dưới 5 triệu",
        "5-10" => "5 - 10 triệu",
        "10-20" => "10 - 20 triệu",
        "over-20" => "Trên 20 triệu",
        _ => "Tất cả"
    };

    private static string SortLabel(string? sortBy) => sortBy?.Trim().ToLowerInvariant() switch
    {
        "price-asc" => "Giá tăng dần",
        "price-desc" => "Giá giảm dần",
        "rating-desc" => "Sao cao nhất",
        _ => "Mặc định"
    };

    private static string UrgencyLabel(string? urgencyFilter) => urgencyFilter?.Trim().ToLowerInvariant() switch
    {
        "last-minute" => "Tour giờ chót",
        "regular" => "Không phải giờ chót",
        _ => "Tất cả"
    };
}
