@model ChillTour.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page auth-page--login">
    <div class="auth-login-shell">
        <div class="auth-login-card">
            <div class="auth-card__intro auth-login-card__intro">
                <span class="eyebrow">ChillTour Account</span>
                <h1>Đăng nhập</h1>
                <p>Chào mừng bạn quay trở lại với ChillTour</p>
            </div>

            <form asp-action="Login" method="post" class="auth-form auth-login-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    <span>Email</span>
                    <span class="auth-input">
                        <span class="auth-input__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z" /><path d="m22 6-10 7L2 6" /></svg>
                        </span>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                    </span>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>

                <label>
                    <span>Mật khẩu</span>
                    <span class="auth-input">
                        <span class="auth-input__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        </span>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span class="auth-input__icon auth-input__icon--end" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /></svg>
                        </span>
                    </span>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </label>

                <div class="auth-login-row">
                    <label class="auth-checkbox">
                        <input asp-for="RememberMe" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <a class="auth-forgot-link" asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-primary booking-submit auth-login-submit">
                    <span aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="m10 17 5-5-5-5" /><path d="M15 12H3" /></svg>
                    </span>
                    Đăng nhập
                </button>
            </form>

            @if (ViewBag.GoogleLoginEnabled is true)
            {
                <div class="auth-divider"><span>hoặc</span></div>

                <form asp-action="GoogleLogin" method="post" class="auth-form auth-form--compact">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <button type="submit" class="btn auth-google-btn">
                        <span class="auth-google-btn__icon">G</span>
                        <span>Đăng nhập với Google</span>
                    </button>
                </form>
            }

            <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a> <span aria-hidden="true">→</span></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
