@model ChillTour.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-card__intro">
                <span class="eyebrow">ChillTour Account</span>
                <h1>Đăng nhập</h1>
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="auth-alert auth-alert--error">@errorMessage</div>
                }
                @if (TempData["SuccessMessage"] is string message)
                {
                    <div class="auth-alert auth-alert--success">@message</div>
                }
            </div>

            <form asp-action="Login" method="post" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    Email
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>

                <label>
                    Mật khẩu
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </label>

                <label class="auth-checkbox">
                    <input asp-for="RememberMe" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>

                <p class="auth-switch auth-switch--inline"><a asp-action="ForgotPassword">Quên mật khẩu?</a></p>
                <button type="submit" class="btn btn-primary booking-submit">Đăng nhập</button>
            </form>

            @if (ViewBag.GoogleLoginEnabled is true)
            {
                <div class="auth-divider"><span>hoặc</span></div>

                <form asp-action="GoogleLogin" method="post" class="auth-form auth-form--compact">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />
                    <button type="submit" class="btn auth-google-btn">
                        <span class="auth-google-btn__icon">G</span>
                        <span>Đăng nhập với Google</span>
                    </button>
                </form>
            }

            <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
