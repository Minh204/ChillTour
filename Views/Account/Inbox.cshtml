@using ChillTour.Security
@model ChillTour.Models.Account.CustomerInboxPageViewModel
@{
    ViewData["Title"] = "Thông báo";
    var unreadCount = Model.Notifications.Count(x => !x.IsRead);
}

@section Styles {
    <link rel="stylesheet" href="~/pages/tours/tours.css" asp-append-version="true" />
}

<section class="customer-profile-page">
    <div class="container customer-profile-shell">
        <main class="customer-profile-main">
            <section class="customer-notification-hero">
                <div>
                    <span class="eyebrow eyebrow--warm">Hộp thư</span>
                    <h1>Thông báo của bạn</h1>
                    <p>Theo dõi các cập nhật quan trọng về đơn đặt tour, thanh toán, hợp đồng, hoàn tiền và nhắc việc vận hành.</p>
                </div>
                <div class="customer-notification-hero__art">
                    <span>✉</span>
                    <strong>@unreadCount</strong>
                </div>
            </section>

            <form method="get" class="customer-profile-filter customer-notification-filter">
                <label>
                    Từ khóa
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tiêu đề hoặc nội dung..." />
                </label>
                <label>
                    Loại liên quan
                    <select name="relatedEntityType" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="Booking" selected="@(Model.RelatedEntityType == "Booking")">Đơn đặt tour</option>
                        <option value="Contract" selected="@(Model.RelatedEntityType == "Contract")">Hợp đồng</option>
                    </select>
                </label>
                <label>
                    Trạng thái đọc
                    <select name="isRead" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="false" selected="@(Model.IsRead == false)">Chưa đọc</option>
                        <option value="true" selected="@(Model.IsRead == true)">Đã đọc</option>
                    </select>
                </label>
                <div class="customer-profile-filter__actions">
                    <button type="submit" class="btn btn-primary">Lọc thông báo</button>
                    <a asp-action="Inbox" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>

            <div class="customer-order-head">
                <h2>Danh sách thông báo (@Model.TotalItems)</h2>
            </div>

            @if (Model.Notifications.Count == 0)
            {
                <div class="auth-alert auth-alert--error">Hộp thư của bạn hiện chưa có thông báo phù hợp.</div>
            }
            else
            {
                <div class="customer-notification-list">
                    @foreach (var notification in Model.Notifications)
                    {
                        var iconClass = NotificationIconClass(notification.RelatedEntityType, notification.IsRelatedBookingCancelled);
                        <article class="customer-notification-row @(notification.IsRead ? string.Empty : "is-unread")" data-notification-row data-notification-id="@notification.NotificationId">
                            <span class="notification-dot @(notification.IsRead ? string.Empty : "is-unread")"></span>
                            <div class="customer-notification-row__icon @iconClass">
                                @NotificationIcon(notification.RelatedEntityType, notification.IsRelatedBookingCancelled)
                            </div>
                            <div class="customer-notification-row__content">
                                <div class="customer-notification-row__head">
                                    <h3>@notification.Title</h3>
                                    <span class="customer-order-status @(notification.IsRead ? "is-info" : "is-warning")">
                                        @(notification.IsRead ? "Đã đọc" : "Mới")
                                    </span>
                                </div>
                                <p>@notification.Message</p>
                            </div>
                            <time>@notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                            <div class="customer-notification-row__action">
                                @if (notification.RelatedEntityType == "Booking" && notification.RelatedEntityId.HasValue)
                                {
                                    if (User.IsInRole(RoleConstants.Customer))
                                    {
                                        <a asp-controller="Payments" asp-action="Checkout" asp-route-bookingId="@notification.RelatedEntityId.Value" class="btn @(notification.IsRelatedBookingCancelled ? "btn-outline-danger" : "btn-outline-primary")">
                                            @(notification.IsRelatedBookingCancelled ? "Đơn đã hủy" : "Xem")
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary">Mở xử lý đơn</a>
                                    }
                                }
                                else if (notification.RelatedEntityType == "Contract" && notification.RelatedEntityId.HasValue)
                                {
                                    <a asp-controller="Contracts" asp-action="Details" asp-route-id="@notification.RelatedEntityId.Value" class="btn btn-outline-primary">Xem hợp đồng</a>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--info">Hệ thống</span>
                                }
                                <form asp-action="DeleteNotification" method="post" class="customer-notification-delete-form" data-delete-notification-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="notificationId" value="@notification.NotificationId" />
                                    <button type="submit" class="customer-notification-delete-btn" aria-label="Đưa thông báo vào thùng rác" title="Đưa vào thùng rác">
                                        ×
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="customer-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Inbox" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-relatedEntityType="@Model.RelatedEntityType" asp-route-isRead="@Model.IsRead" class="customer-pagination__link">Trước</a>
                        }
                        else
                        {
                            <span class="customer-pagination__link is-disabled">Trước</span>
                        }

                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a asp-action="Inbox" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.SearchTerm" asp-route-relatedEntityType="@Model.RelatedEntityType" asp-route-isRead="@Model.IsRead" class="customer-pagination__link @(pageNumber == Model.CurrentPage ? "is-active" : "")">@pageNumber</a>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Inbox" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-relatedEntityType="@Model.RelatedEntityType" asp-route-isRead="@Model.IsRead" class="customer-pagination__link">Sau</a>
                        }
                        else
                        {
                            <span class="customer-pagination__link is-disabled">Sau</span>
                        }
                    </div>
                }
            }
        </main>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const totalHeading = document.querySelector('.customer-order-head h2');
            const emptyMessage = 'Hộp thư của bạn hiện chưa có thông báo phù hợp.';
            let totalItems = @Model.TotalItems;

            const updateTotal = () => {
                const rows = document.querySelectorAll('[data-notification-row]').length;
                totalItems = Math.max(0, totalItems - 1);
                if (totalHeading) {
                    totalHeading.textContent = `Danh sách thông báo (${totalItems})`;
                }

                const list = document.querySelector('.customer-notification-list');
                if (list && rows === 0) {
                    list.insertAdjacentHTML('afterend', `<div class="auth-alert auth-alert--error">${emptyMessage}</div>`);
                    list.remove();
                }
            };

            document.addEventListener('submit', async (event) => {
                const form = event.target.closest('[data-delete-notification-form]');
                if (!form) {
                    return;
                }

                event.preventDefault();

                const row = form.closest('[data-notification-row]');
                const button = form.querySelector('button[type="submit"]');
                button?.setAttribute('disabled', 'disabled');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        window.ChillTourToast?.(data.message || 'Không thể xóa thông báo.', 'error', 'Thông báo');
                        return;
                    }

                    const badge = document.querySelector('[data-notification-badge]');
                    if (badge) {
                        const count = Number(data.unreadCount || 0);
                        badge.textContent = String(count);
                        badge.classList.toggle('is-hidden', count <= 0);
                    }

                    row?.classList.add('is-removing');
                    window.setTimeout(() => {
                        row?.remove();
                        updateTotal();
                    }, 180);
                    window.ChillTourToast?.(data.message || 'Đã đưa thông báo vào thùng rác.', 'success', 'Thông báo');
                } catch {
                    window.ChillTourToast?.('Có lỗi khi xóa thông báo. Vui lòng thử lại.', 'error', 'Thông báo');
                } finally {
                    button?.removeAttribute('disabled');
                }
            });
        })();
    </script>
}

@functions {
    private static string NotificationIcon(string? relatedType, bool isCancelled) => isCancelled ? "!" : relatedType switch
    {
        "Booking" => "□",
        "Contract" => "§",
        _ => "i"
    };

    private static string NotificationIconClass(string? relatedType, bool isCancelled) => isCancelled ? "is-danger" : relatedType switch
    {
        "Booking" => "is-info",
        "Contract" => "is-success",
        _ => "is-warning"
    };
}
