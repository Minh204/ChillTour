@model ChillTour.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-card__intro">
                <span class="eyebrow">ChillTour Account</span>
                <h1>Đặt lại mật khẩu</h1>
                <p>Tạo mật khẩu mới cho tài khoản của bạn.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    Email
                    <input value="@Model.Email" class="form-control" disabled />
                </label>

                <label>
                    Mật khẩu mới
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </label>

                <label>
                    Xác nhận mật khẩu mới
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </label>

                <button type="submit" class="btn btn-primary booking-submit">Cập nhật mật khẩu</button>
                <p class="auth-switch"><a asp-action="Login">Quay lại đăng nhập</a></p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
