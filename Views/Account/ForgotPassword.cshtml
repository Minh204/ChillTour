@model ChillTour.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-card__intro">
                <span class="eyebrow eyebrow--warm">Khôi phục tài khoản</span>
                <h1>Quên mật khẩu</h1>
                <p>Nhập email đã đăng ký. Hệ thống sẽ gửi liên kết đặt lại mật khẩu nếu tài khoản tồn tại.</p>
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="auth-alert auth-alert--error">@errorMessage</div>
                }
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="auth-alert auth-alert--success">@successMessage</div>
                }
            </div>

            <form asp-action="ForgotPassword" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    Email
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>

                <button type="submit" class="btn btn-primary booking-submit">Gửi liên kết đặt lại</button>
                <p class="auth-switch">Đã nhớ mật khẩu? <a asp-action="Login">Quay lại đăng nhập</a></p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
