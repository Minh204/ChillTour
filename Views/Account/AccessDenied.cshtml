@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="auth-card__intro">
                <span class="eyebrow eyebrow--warm">Access Denied</span>
