@model ChillTour.Models.Account.CustomerBookingsPageViewModel
@{
    ViewData["Title"] = "Profile khách hàng";
    var customerName = User.Identity?.Name ?? "Khách hàng";
    var totalBookings = Model.TotalItems;
    var completedBookings = Model.Bookings.Count(x => x.IsCompletedByDeparture || x.BookingStatus is 3 or 8);
    var waitingPayment = Model.Bookings.Count(x => x.RemainingAmount > 0m && x.BookingStatus is not 4 and not 5);
    var upcomingBookings = Model.Bookings.Count(x => x.DepartureDate >= DateOnly.FromDateTime(DateTime.Today) && x.BookingStatus is not 4 and not 5);
}

@section Styles {
    <link rel="stylesheet" href="~/pages/tours/tours.css" asp-append-version="true" />
}

<section class="customer-profile-page">
    <div class="container customer-profile-shell">
        <main class="customer-profile-main">
            <section class="customer-profile-hero">
                <div>
                    <h1>Xin chào, @customerName! <span>👋</span></h1>
                    <p>Cùng nhìn lại những chuyến đi tuyệt vời của bạn</p>
                </div>
                <div class="customer-stats-grid">
                    <div class="customer-stat-card">
                        <span class="customer-stat-card__icon">▣</span>
                        <small>Tổng đơn hàng</small>
                        <strong>@totalBookings</strong>
                        <em>Đơn phù hợp bộ lọc</em>
                    </div>
                    <div class="customer-stat-card">
                        <span class="customer-stat-card__icon is-success">✓</span>
                        <small>Đã hoàn thành</small>
                        <strong>@completedBookings</strong>
                        <em>Đơn đã đi hoặc đã xác nhận</em>
                    </div>
                    <div class="customer-stat-card">
                        <span class="customer-stat-card__icon is-warning">◷</span>
                        <small>Chờ thanh toán</small>
                        <strong>@waitingPayment</strong>
                        <em>Đơn còn phải thanh toán</em>
                    </div>
                    <div class="customer-stat-card">
                        <span class="customer-stat-card__icon is-purple">▣</span>
                        <small>Sắp tới</small>
                        <strong>@upcomingBookings</strong>
                        <em>Lịch chưa khởi hành</em>
                    </div>
                </div>
            </section>

            @if (TempData["BookingSuccessMessage"] is string bookingSuccessMessage)
            {
                <div class="auth-alert auth-alert--success">@bookingSuccessMessage</div>
            }
            @if (TempData["BookingErrorMessage"] is string bookingErrorMessage)
            {
                <div class="auth-alert auth-alert--error">@bookingErrorMessage</div>
            }

            <form method="get" class="customer-profile-filter">
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                <label>
                    Từ khóa
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Mã đơn, tên tour..." />
                </label>
                <label>
                    Trạng thái đơn
                    <select name="bookingStatus" class="form-select">
                        <option value="">Tất cả</option>
                        @for (var status = 0; status <= 10; status++)
                        {
                            <option value="@status" selected="@(Model.BookingStatus == status)">@StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <label>
                    Trạng thái thanh toán
                    <select name="paymentStatus" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1" selected="@(Model.PaymentStatus == 1)">Chờ xác nhận</option>
                        <option value="2" selected="@(Model.PaymentStatus == 2)">Đã cọc</option>
                        <option value="3" selected="@(Model.PaymentStatus == 3)">Đã thanh toán đủ</option>
                    </select>
                </label>
                <label>
                    Từ ngày
                    <input type="date" name="departureFrom" value="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
                </label>
                <label>
                    Đến ngày
                    <input type="date" name="departureTo" value="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" class="form-control" />
                </label>
                <div class="customer-profile-filter__actions">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a asp-action="Bookings" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>

            <div class="customer-order-head">
                <h2>Danh sách đơn hàng (@totalBookings)</h2>
                <form method="get" class="customer-sort-form">
                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="bookingStatus" value="@Model.BookingStatus" />
                    <input type="hidden" name="paymentStatus" value="@Model.PaymentStatus" />
                    <input type="hidden" name="departureFrom" value="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="departureTo" value="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" />
                    <select name="sortOrder" class="form-select" aria-label="Sắp xếp" onchange="this.form.submit()">
                        <option value="newest" selected="@(Model.SortOrder == "newest")">Sắp xếp: Mới nhất</option>
                        <option value="departure" selected="@(Model.SortOrder == "departure")">Sắp xếp: Khởi hành gần nhất</option>
                        <option value="amount_desc" selected="@(Model.SortOrder == "amount_desc")">Sắp xếp: Tổng tiền cao nhất</option>
                    </select>
                </form>
            </div>

            @if (Model.Bookings.Count == 0)
            {
                <div class="auth-alert auth-alert--error">Không có đơn nào phù hợp với bộ lọc hiện tại.</div>
            }
            else
            {
                <div class="customer-order-list">
                    @foreach (var booking in Model.Bookings)
                    {
                        var paidPercent = booking.TotalAmount > 0m
                            ? Math.Clamp((int)Math.Round(booking.PaidAmount / booking.TotalAmount * 100m), 0, 100)
                            : 0;
                        var progressClass = paidPercent >= 100 ? "is-complete" : paidPercent >= 60 ? "is-good" : paidPercent > 0 ? "is-partial" : string.Empty;

                        <article class="customer-order-card">
                            <div class="customer-order-card__image">
                                @if (!string.IsNullOrWhiteSpace(booking.ImageUrl))
                                {
                                    <img src="@booking.ImageUrl" alt="@booking.TourName" />
                                }
                                else
                                {
                                    <span>ChillTour</span>
                                }
                            </div>

                            <div class="customer-order-card__content">
                                <span class="customer-order-status @StatusClass(booking.BookingStatus, booking.IsCompletedByDeparture)">@booking.BookingStatusText</span>
                                <h3>@booking.TourName</h3>
                                <div class="customer-order-meta">
                                    <span>@booking.DepartureDate.ToString("dd/MM/yyyy")</span>
                                    <span>@booking.Travelers khách</span>
                                    <span>Tạo lúc @booking.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p>Mã đơn: <strong>@booking.BookingCode</strong></p>
                            </div>

                            <div class="customer-order-payment">
                                <div class="customer-order-progress__label">
                                    <strong>Thanh toán @paidPercent%</strong>
                                    <span>@paidPercent%</span>
                                </div>
                                <div class="customer-order-progress">
                                    <span class="@progressClass" style="width: @paidPercent%"></span>
                                </div>
                                <div class="customer-order-money">
                                    <div>
                                        <span>Tổng tiền</span>
                                        <strong>@booking.TotalAmount.ToString("N0")đ</strong>
                                    </div>
                                    <div>
                                        <span>Đã thanh toán</span>
                                        <strong class="is-paid">@booking.PaidAmount.ToString("N0")đ</strong>
                                    </div>
                                    <div>
                                        <span>Còn lại</span>
                                        <strong class="is-due">@booking.RemainingAmount.ToString("N0")đ</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="customer-order-action">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#bookingActionModal"
                                        data-booking-id="@booking.BookingId"
                                        data-booking-code="@booking.BookingCode"
                                        data-tour-name="@booking.TourName"
                                        data-tour-url="@(Url.Action("Details", "Tours", new { slug = booking.TourSlug }) ?? "#")"
                                        data-payment-url="@(Url.Action("Checkout", "Payments", new { bookingId = booking.BookingId }) ?? "#")"
                                        data-contract-url="@(booking.ContractId.HasValue ? Url.Action("Details", "Contracts", new { id = booking.ContractId.Value }) : string.Empty)"
                                        data-can-cancel="@((booking.CanCancel || booking.CanRequestRefund).ToString().ToLowerInvariant())"
                                        data-refund-request="@booking.RequiresRefundRequest.ToString().ToLowerInvariant()"
                                        data-refund-percent="@booking.RefundPercent"
                                        data-refund-amount="@booking.EstimatedRefundAmount.ToString("N0")">
                                    Xem chi tiết
                                </button>
                            </div>
                        </article>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="customer-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Bookings" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-bookingStatus="@Model.BookingStatus" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-departureFrom="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" asp-route-sortOrder="@Model.SortOrder" class="customer-pagination__link">Trước</a>
                        }
                        else
                        {
                            <span class="customer-pagination__link is-disabled">Trước</span>
                        }

                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <a asp-action="Bookings" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.SearchTerm" asp-route-bookingStatus="@Model.BookingStatus" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-departureFrom="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" asp-route-sortOrder="@Model.SortOrder" class="customer-pagination__link @(pageNumber == Model.CurrentPage ? "is-active" : "")">@pageNumber</a>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Bookings" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-bookingStatus="@Model.BookingStatus" asp-route-paymentStatus="@Model.PaymentStatus" asp-route-departureFrom="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" asp-route-sortOrder="@Model.SortOrder" class="customer-pagination__link">Sau</a>
                        }
                        else
                        {
                            <span class="customer-pagination__link is-disabled">Sau</span>
                        }
                    </div>
                }
            }
        </main>
    </div>
</section>

<div class="modal fade" id="bookingActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 id="bookingActionTitle" class="modal-title">Chi tiết đơn</h5>
                    <p id="bookingActionSubtitle" class="text-muted small mb-0"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="booking-action-list">
                    <a id="bookingActionTour" class="btn btn-outline-primary" href="#">Xem tour</a>
                    <a id="bookingActionPayment" class="btn btn-primary" href="#">Xem thanh toán</a>
                    <a id="bookingActionContract" class="btn btn-outline-primary" href="#">Xem hợp đồng</a>
                    <button id="bookingActionCancel" type="button" class="btn btn-outline-danger">Yêu cầu hoàn tiền</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CancelBooking" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 id="cancelBookingTitle" class="modal-title">Xác nhận hủy đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cancelBookingId" name="BookingId" />
                    <p id="cancelBookingText" class="mb-3"></p>
                    <label>
                        Lý do
                        <textarea id="cancelBookingReason" name="CancellationReason" class="form-control admin-textarea" maxlength="500" required></textarea>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button id="cancelBookingSubmit" type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (() => {
        const cancelModal = document.getElementById('cancelBookingModal');
        if (!cancelModal) return;

        const fillCancelModal = button => {
            document.getElementById('cancelBookingId').value = button?.getAttribute('data-booking-id') || button?.dataset.bookingId || '';
            document.getElementById('cancelBookingReason').value = '';
            const isRefundRequest = (button?.getAttribute('data-refund-request') || button?.dataset.refundRequest) === 'true';
            const bookingCode = button?.getAttribute('data-booking-code') || button?.dataset.bookingCode || '';
            const tourName = button?.getAttribute('data-tour-name') || button?.dataset.tourName || '';
            const refundPercent = button?.getAttribute('data-refund-percent') || button?.dataset.refundPercent || '0';
            const refundAmount = button?.getAttribute('data-refund-amount') || button?.dataset.refundAmount || '0';
            document.getElementById('cancelBookingTitle').textContent = isRefundRequest ? 'Yêu cầu hoàn tiền' : 'Xác nhận hủy đơn';
            document.getElementById('cancelBookingSubmit').textContent = isRefundRequest ? 'Gửi yêu cầu hoàn tiền' : 'Xác nhận hủy';
            document.getElementById('cancelBookingText').textContent = isRefundRequest
                ? `Bạn muốn gửi yêu cầu hoàn tiền cho đơn ${bookingCode} của tour "${tourName}"? Chính sách hoàn tiền dự kiến: ${refundPercent}% số tiền đã thanh toán (${refundAmount} đ). Nhân viên sẽ kiểm tra trước khi xử lý hoàn tiền.`
                : `Bạn có chắc muốn hủy đơn ${bookingCode} của tour "${tourName}" không?`;
        };

        cancelModal.addEventListener('show.bs.modal', event => {
            if (event.relatedTarget) {
                fillCancelModal(event.relatedTarget);
            }
        });

        const actionModal = document.getElementById('bookingActionModal');
        if (!actionModal) return;

        const actionCancel = document.getElementById('bookingActionCancel');
        actionModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            if (!button) return;

            document.getElementById('bookingActionTitle').textContent = `Đơn ${button.getAttribute('data-booking-code') || ''}`;
            document.getElementById('bookingActionSubtitle').textContent = button.getAttribute('data-tour-name') || '';
            document.getElementById('bookingActionTour').href = button.getAttribute('data-tour-url') || '#';
            document.getElementById('bookingActionPayment').href = button.getAttribute('data-payment-url') || '#';

            const contractUrl = button.getAttribute('data-contract-url') || '';
            const contractAction = document.getElementById('bookingActionContract');
            contractAction.href = contractUrl || '#';
            contractAction.classList.toggle('disabled', !contractUrl);
            contractAction.setAttribute('aria-disabled', contractUrl ? 'false' : 'true');

            const canCancel = button.getAttribute('data-can-cancel') === 'true';
            actionCancel.hidden = !canCancel;
            actionCancel.textContent = button.getAttribute('data-refund-request') === 'true' ? 'Yêu cầu hoàn tiền' : 'Hủy đặt';
            actionCancel.dataset.bookingId = button.getAttribute('data-booking-id') || '';
            actionCancel.dataset.bookingCode = button.getAttribute('data-booking-code') || '';
            actionCancel.dataset.tourName = button.getAttribute('data-tour-name') || '';
            actionCancel.dataset.refundRequest = button.getAttribute('data-refund-request') || 'false';
            actionCancel.dataset.refundPercent = button.getAttribute('data-refund-percent') || '0';
            actionCancel.dataset.refundAmount = button.getAttribute('data-refund-amount') || '0';
        });

        actionCancel.addEventListener('click', () => {
            fillCancelModal(actionCancel);
            const currentModal = bootstrap.Modal.getOrCreateInstance(actionModal);
            const nextModal = bootstrap.Modal.getOrCreateInstance(cancelModal);
            currentModal.hide();
            actionModal.addEventListener('hidden.bs.modal', () => nextModal.show(), { once: true });
        });
    })();
</script>

@functions {
    private static string StatusLabel(int status) => status switch
    {
        0 => "Chờ thanh toán",
        1 => "Chờ xác nhận thanh toán",
        2 => "Đã cọc",
        3 => "Đã đặt",
        4 => "Đã hủy",
        5 => "Đã hoàn tiền",
        6 => "Chờ thanh toán còn lại",
        7 => "Chờ xác nhận thanh toán",
        8 => "Đã thanh toán đầy đủ",
        9 => "Yêu cầu hoàn tiền",
        10 => "Chờ hoàn tiền",
        _ => "Không xác định"
    };

    private static string StatusClass(int status, bool isCompleted = false) => isCompleted ? "is-success" : status switch
    {
        2 or 3 or 8 => "is-success",
        4 or 5 => "is-danger",
        9 or 10 => "is-warning",
        _ => "is-info"
    };
}
