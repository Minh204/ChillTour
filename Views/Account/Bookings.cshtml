@model ChillTour.Models.Account.CustomerBookingsPageViewModel
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/pages/tours/tours.css" asp-append-version="true" />
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card booking-history-card booking-history-card--wide">
            <div class="auth-card__intro booking-history-hero">
                <span class="eyebrow">Đơn hàng</span>
                <h1>Lịch sử đặt tour</h1>
                <p>Theo dõi trạng thái đơn, thanh toán và hoàn tiền trên một luồng xử lý thống nhất. Các đơn đã cọc nhưng không thanh toán đủ trước 3 ngày khởi hành sẽ tự động hủy và không còn đủ điều kiện hoàn tiền.</p>
            </div>

            @if (TempData["BookingSuccessMessage"] is string bookingSuccessMessage)
            {
                <div class="auth-alert auth-alert--success">@bookingSuccessMessage</div>
            }
            @if (TempData["BookingErrorMessage"] is string bookingErrorMessage)
            {
                <div class="auth-alert auth-alert--error">@bookingErrorMessage</div>
            }

            <form method="get" class="booking-history-filter">
                <label>
                    Từ khóa
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Mã đơn hoặc tên tour..." />
                </label>
                <label>
                    Trạng thái đơn
                    <select name="bookingStatus" class="form-select">
                        <option value="">Tất cả</option>
                        @for (var status = 0; status <= 10; status++)
                        {
                            <option value="@status" selected="@(Model.BookingStatus == status)">@StatusLabel(status)</option>
                        }
                    </select>
                </label>
                <label>
                    Trạng thái thanh toán
                    <select name="paymentStatus" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1" selected="@(Model.PaymentStatus == 1)">Chờ xác nhận</option>
                        <option value="2" selected="@(Model.PaymentStatus == 2)">Đã cọc</option>
                        <option value="3" selected="@(Model.PaymentStatus == 3)">Đã thanh toán đủ</option>
                    </select>
                </label>
                <label>
                    Từ ngày khởi hành
                    <input type="date" name="departureFrom" value="@(Model.DepartureFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
                </label>
                <label>
                    Đến ngày khởi hành
                    <input type="date" name="departureTo" value="@(Model.DepartureTo?.ToString("yyyy-MM-dd"))" class="form-control" />
                </label>
                <div class="booking-history-filter__actions">
                    <button type="submit" class="btn btn-primary">Lọc đơn</button>
                    <a asp-action="Bookings" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>

            @if (Model.Bookings.Count == 0)
            {
                <div class="auth-alert auth-alert--error">Không có đơn nào phù hợp với bộ lọc hiện tại.</div>
            }
            else
            {
                <div class="customer-booking-list customer-booking-list--spacious">
                    @foreach (var booking in Model.Bookings)
                    {
                        <article class="customer-booking-card customer-booking-card--timeline">
                            <div class="customer-booking-card__top">
                                <div class="customer-booking-card__identity">
                                    <span class="tour-tag">@booking.BookingCode</span>
                                    <h3>@booking.TourName</h3>
                                    <p>Khởi hành @booking.DepartureDate.ToString("dd/MM/yyyy") • @booking.Travelers khách • Tạo lúc @booking.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                                <div class="customer-booking-card__status">
                                    <span class="status-pill @StatusClass(booking.BookingStatus)">
                                        @StatusLabel(booking.BookingStatus)
                                    </span>
                                    <span class="status-pill @PaymentStatusClass(booking.PaymentStatus)">
                                        @PaymentStatusLabel(booking.PaymentStatus)
                                    </span>
                                </div>
                            </div>

                            <div class="customer-booking-card__meta-grid">
                                <div>
                                    <span>Tổng tiền</span>
                                    <strong>@booking.TotalAmount.ToString("N0") đ</strong>
                                </div>
                                <div>
                                    <span>Đã thanh toán</span>
                                    <strong>@booking.PaidAmount.ToString("N0") đ</strong>
                                </div>
                                <div>
                                    <span>Còn lại</span>
                                    <strong>@booking.RemainingAmount.ToString("N0") đ</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(booking.CancellationReason))
                            {
                                <p class="customer-booking-card__reason">Lý do hủy: @booking.CancellationReason</p>
                            }

                            <div class="customer-booking-card__footer">
                                <a asp-controller="Tours" asp-action="Details" asp-route-slug="@booking.TourSlug" class="btn btn-outline-primary">Xem tour</a>
                                <a asp-controller="Payments" asp-action="Checkout" asp-route-bookingId="@booking.BookingId" class="btn btn-primary">Xem thanh toán</a>
                                @if (booking.CanCancel)
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#cancelBookingModal"
                                            data-booking-id="@booking.BookingId"
                                            data-booking-code="@booking.BookingCode"
                                            data-tour-name="@booking.TourName"
                                            data-refund-request="@booking.RequiresRefundRequest.ToString().ToLowerInvariant()">
                                        @(booking.RequiresRefundRequest ? "Yêu cầu hoàn tiền" : "Hủy đặt")
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CancelBooking" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 id="cancelBookingTitle" class="modal-title">Xác nhận hủy đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cancelBookingId" name="BookingId" />
                    <p id="cancelBookingText" class="mb-3"></p>
                    <label>
                        Lý do
                        <textarea id="cancelBookingReason" name="CancellationReason" class="form-control admin-textarea" maxlength="500" required></textarea>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button id="cancelBookingSubmit" type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (() => {
        const cancelModal = document.getElementById('cancelBookingModal');
        if (!cancelModal) {
            return;
        }

        cancelModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            document.getElementById('cancelBookingId').value = button.getAttribute('data-booking-id') || '';
            document.getElementById('cancelBookingReason').value = '';
            const isRefundRequest = button.getAttribute('data-refund-request') === 'true';
            const bookingCode = button.getAttribute('data-booking-code') || '';
            const tourName = button.getAttribute('data-tour-name') || '';
            document.getElementById('cancelBookingTitle').textContent = isRefundRequest ? 'Yêu cầu hoàn tiền' : 'Xác nhận hủy đơn';
            document.getElementById('cancelBookingSubmit').textContent = isRefundRequest ? 'Gửi yêu cầu hoàn tiền' : 'Xác nhận hủy';
            document.getElementById('cancelBookingText').textContent = isRefundRequest
                ? `Bạn muốn gửi yêu cầu hoàn tiền cho đơn ${bookingCode} của tour "${tourName}"? Staff sẽ kiểm tra trước khi chuyển Accountant hoàn tiền.`
                : `Bạn có chắc muốn hủy đơn ${bookingCode} của tour "${tourName}" không?`;
        });
    })();
</script>

@functions {
    private static string StatusLabel(int status) => status switch
    {
        0 => "Chờ thanh toán",
        1 => "Chờ xác nhận cọc",
        2 => "Đã cọc",
        3 => "Đã xác nhận booking",
        4 => "Đã hủy",
        5 => "Đã hoàn tiền",
        6 => "Chờ thanh toán còn lại",
        7 => "Chờ xác nhận thanh toán đủ",
        8 => "Đã thanh toán đủ",
        9 => "Yêu cầu hoàn tiền",
        10 => "Chờ hoàn tiền",
        _ => "Không xác định"
    };

    private static string StatusClass(int status) => status switch
    {
        2 or 3 or 8 => "status-pill--success",
        4 or 5 => "status-pill--danger",
        9 or 10 => "status-pill--warning",
        _ => "status-pill--info"
    };

    private static string PaymentStatusLabel(int status) => status switch
    {
        1 => "Chờ xác nhận thanh toán",
        2 => "Đã cọc",
        3 => "Đã thanh toán đủ",
        4 => "Thanh toán thất bại",
        _ => "Chờ thanh toán"
    };

    private static string PaymentStatusClass(int status) => status switch
    {
        2 or 3 => "status-pill--success",
        4 => "status-pill--danger",
        1 => "status-pill--warning",
        _ => "status-pill--info"
    };
}
