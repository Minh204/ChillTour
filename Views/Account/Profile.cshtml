@model ChillTour.Models.Account.AccountProfilePageViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<section class="account-settings-page">
    <div class="account-settings-hero">
        <div class="container">
            <nav class="account-settings-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <span aria-hidden="true">›</span>
                <span>Tài khoản</span>
            </nav>
            <div class="account-settings-hero__content">
                <div>
                    <span class="eyebrow">ChillTour account</span>
                    <h1>Tài khoản của tôi</h1>
                    <p>Quản lý thông tin cá nhân và bảo mật tài khoản ChillTour của bạn.</p>
                </div>
                <div class="account-settings-hero__badge" aria-hidden="true">
                    <span>@((User.Identity?.Name ?? "C").Substring(0, 1).ToUpperInvariant())</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container account-settings-layout">
        <article class="account-settings-card">
            <header class="account-settings-card__head">
                <span class="account-settings-card__icon account-settings-card__icon--blue" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 21a8 8 0 0 0-16 0" />
                        <path d="M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
                    </svg>
                </span>
                <div>
                    <h2>Thông tin cá nhân</h2>
                    <p>Cập nhật thông tin để bảo mật và nhận hỗ trợ nhanh hơn.</p>
                </div>
            </header>

            <form asp-action="UpdateProfile" method="post" class="account-settings-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    <span>Họ và tên</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 21a8 8 0 0 0-16 0" />
                            <path d="M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" />
                        </svg>
                        <input asp-for="Profile.FullName" class="form-control" autocomplete="name" />
                    </span>
                    <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                </label>

                <label>
                    <span>Email</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 4h16v16H4z" />
                            <path d="m22 6-10 7L2 6" />
                        </svg>
                        <input asp-for="Profile.Email" class="form-control" readonly autocomplete="email" />
                    </span>
                    <span asp-validation-for="Profile.Email" class="text-danger"></span>
                </label>

                <label>
                    <span>Số điện thoại</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.7.6 2.5a2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6.5 6.5l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.6.5 2.5.6A2 2 0 0 1 22 16.9Z" />
                        </svg>
                        <input asp-for="Profile.PhoneNumber" class="form-control" autocomplete="tel" />
                    </span>
                    <span asp-validation-for="Profile.PhoneNumber" class="text-danger"></span>
                </label>

                <button type="submit" class="account-settings-submit account-settings-submit--primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
                        <path d="M17 21v-8H7v8" />
                        <path d="M7 3v5h8" />
                    </svg>
                    Lưu thông tin
                </button>

                <p class="account-settings-note">
                    <span aria-hidden="true">✓</span>
                    Thông tin của bạn được bảo mật tuyệt đối.
                </p>
            </form>
        </article>

        <article class="account-settings-card">
            <header class="account-settings-card__head">
                <span class="account-settings-card__icon account-settings-card__icon--green" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                        <path d="m9 12 2 2 4-5" />
                    </svg>
                </span>
                <div>
                    <h2>Đổi mật khẩu</h2>
                    <p>Tạo mật khẩu mới để tăng độ an toàn cho tài khoản.</p>
                </div>
            </header>

            <form asp-action="ChangePassword" method="post" class="account-settings-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <label>
                    <span>Mật khẩu hiện tại</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <input asp-for="ChangePassword.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <button type="button" class="account-settings-eye" data-password-toggle aria-label="Hiện hoặc ẩn mật khẩu">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            </svg>
                        </button>
                    </span>
                    <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
                </label>

                <label>
                    <span>Mật khẩu mới</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <input asp-for="ChangePassword.NewPassword" class="form-control" autocomplete="new-password" />
                        <button type="button" class="account-settings-eye" data-password-toggle aria-label="Hiện hoặc ẩn mật khẩu">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            </svg>
                        </button>
                    </span>
                    <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                </label>

                <label>
                    <span>Xác nhận mật khẩu mới</span>
                    <span class="account-settings-input">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <input asp-for="ChangePassword.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <button type="button" class="account-settings-eye" data-password-toggle aria-label="Hiện hoặc ẩn mật khẩu">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            </svg>
                        </button>
                    </span>
                    <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger"></span>
                </label>

                <button type="submit" class="account-settings-submit account-settings-submit--success">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="11" width="14" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    Đổi mật khẩu
                </button>

                <p class="account-settings-note">
                    <span aria-hidden="true">✓</span>
                    Mật khẩu nên có ít nhất 8 ký tự, gồm chữ, số và ký tự đặc biệt.
                </p>
            </form>
        </article>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-password-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
                const input = button.closest('.account-settings-input')?.querySelector('input');
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
                button.classList.toggle('is-visible', input.type === 'text');
            });
        });
    </script>
}
