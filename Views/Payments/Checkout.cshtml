@model ChillTour.Models.Payments.PaymentCheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán tour";

    var dueDateText = Model.BalanceDueAt?.ToString("dd/MM/yyyy") ?? Model.DepartureDate.AddDays(-5).ToString("dd/MM/yyyy");
    var isCancelled = Model.BookingStatus == 4;
    var paymentStatusText = isCancelled
        ? "Đơn đã hủy"
        : Model.IsFullyPaid
            ? "Đã thanh toán đầy đủ"
            : Model.PaymentStatus == 1
                ? "Đã thanh toán thành công, chờ xác nhận"
                : Model.PaidAmount > 0
                    ? "Đã cọc"
                    : "Chờ thanh toán";
    var primaryAmount = isCancelled
        ? 0m
        : Model.CanPayFull && Model.MustPayFull
            ? Model.FullPaymentAmount
            : Model.CanPayDeposit
                ? Model.DepositAmount
                : Model.RemainingAmount;
    var defaultPaymentMode = Model.MustPayFull ? "full" : "deposit";
    var totalDiscount = Model.LastMinuteDiscountAmount + Model.DiscountAmount;
    var hasActivePayment = !isCancelled && Model.CanPay;
    var canApplyPromotion = Model.PaidAmount <= 0m && Model.CanPay;
}

@section Styles {
    <link rel="stylesheet" href="~/pages/payments/payments.css" asp-append-version="true" />
}

<section class="payment-redesign-page">
    <div class="payment-redesign-topbar">
        <div class="payment-redesign-steps" aria-label="Tiến trình đặt tour">
            <span><i>1</i> Chọn tour</span>
            <span class="is-active"><i>2</i> Thanh toán</span>
            <span><i>3</i> Xác nhận</span>
        </div>
    </div>

    <div class="container payment-redesign-container">
        @if (TempData["PaymentInfoMessage"] is string infoMessage)
        {
            <div class="auth-alert auth-alert--success">@infoMessage</div>
        }
        @if (TempData["PaymentErrorMessage"] is string errorMessage)
        {
            <div class="auth-alert auth-alert--error">@errorMessage</div>
        }

        <a asp-controller="Account" asp-action="Bookings" class="payment-redesign-back">← Quay lại đặt tour</a>

        <div class="payment-redesign-grid">
            <main class="payment-redesign-main">
                <header class="payment-redesign-hero">
                    <span class="eyebrow">Thanh toán</span>
                    <h1>Thanh toán tour</h1>
                    <p>Đặt cọc 30% hoặc thanh toán toàn bộ trước @dueDateText để giữ chỗ.</p>
                </header>

                <div class="payment-redesign-trust">
                    <span>Thanh toán an toàn</span>
                    <span>Bảo mật SSL 256-bit</span>
                    <span>Thông tin được mã hóa</span>
                    <span>Hỗ trợ 24/7</span>
                </div>

                <section class="payment-redesign-panel payment-booking-panel">
                    <h2>Thông tin đặt tour</h2>
                    <div class="payment-booking-grid">
                        <div class="payment-booking-cell payment-booking-cell--code">
                            <span>Mã đơn</span>
                            <strong>@Model.BookingCode</strong>
                            <p>@Model.TourName</p>
                        </div>
                        <div class="payment-booking-cell">
                            <span>Khởi hành</span>
                            <strong>@Model.DepartureDate.ToString("dd/MM/yyyy")</strong>
                            <p>@Model.Travelers khách • @Model.ContactName</p>
                        </div>
                        <div class="payment-booking-cell">
                            <span>Trạng thái</span>
                            <strong class="payment-status-pill">@paymentStatusText</strong>
                            <p>Hạn thanh toán: @dueDateText</p>
                        </div>
                        <div class="payment-booking-cell">
                            <span>Đã thanh toán</span>
                            <strong>@Model.PaidAmount.ToString("N0") đ</strong>
                        </div>
                        <div class="payment-booking-cell payment-booking-cell--accent">
                            <span>Cần thanh toán</span>
                            <strong>@primaryAmount.ToString("N0") đ</strong>
                        </div>
                        <div class="payment-booking-cell">
                            <span>Tổng tiền</span>
                            <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                        </div>
                    </div>
                </section>

                @if (canApplyPromotion || !string.IsNullOrWhiteSpace(Model.AppliedPromotionCode))
                {
                    <section class="payment-redesign-panel payment-redesign-promo">
                        <div>
                            <h2>Mã ưu đãi</h2>
                            @if (!string.IsNullOrWhiteSpace(Model.AppliedPromotionCode))
                            {
                                <p>Đang áp dụng <strong>@Model.AppliedPromotionCode</strong>@(string.IsNullOrWhiteSpace(Model.AppliedPromotionName) ? string.Empty : $" - {Model.AppliedPromotionName}")</p>
                            }
                            else
                            {
                                <p>Nhập mã trước khi tạo giao dịch thanh toán.</p>
                            }
                        </div>
                        <form asp-action="ApplyPromotion" method="post" class="payment-redesign-promo-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <input type="text"
                                   name="promotionCode"
                                   value="@Model.AppliedPromotionCode"
                                   class="form-control"
                                   placeholder="Ví dụ: CHILL10"
                                   @(canApplyPromotion ? null : "disabled") />
                            <button type="submit" class="btn btn-primary" @(canApplyPromotion ? null : "disabled")>Áp dụng</button>
                        </form>
                    </section>
                }

                <section class="payment-redesign-panel payment-method-section">
                    <div class="payment-section-head">
                        <div>
                            <h2>Chọn phương thức thanh toán</h2>
                            <p>SePay là phương thức mặc định. Khi thanh toán nhanh, hệ thống sẽ tạo QR chuyển khoản SePay.</p>
                        </div>
                    </div>

                    <div class="payment-method-inline-grid">
                        <article class="payment-method-tile is-active">
                            <span class="payment-method-badge">Đề xuất</span>
                            <strong>SePay</strong>
                            <small>QR chuyển khoản</small>
                        </article>

                        <form asp-action="StartVnPay" method="post" class="payment-method-tile payment-method-tile--form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <input type="hidden" name="paymentMode" value="@defaultPaymentMode" />
                            <button type="submit" @(hasActivePayment ? null : "disabled")>
                                <strong>VNPay</strong>
                                <small>Thanh toán online</small>
                            </button>
                        </form>

                        <article class="payment-method-tile is-muted">
                            <strong>Chuyển khoản</strong>
                            <small>Thủ công</small>
                        </article>
                        <article class="payment-method-tile is-muted">
                            <strong>Thẻ quốc tế</strong>
                            <small>Visa, Mastercard</small>
                        </article>
                        <article class="payment-method-tile is-muted">
                            <strong>Ví điện tử</strong>
                            <small>MoMo, ZaloPay</small>
                        </article>
                    </div>

                    <div class="payment-sepay-preview" data-sepay-preview>
                        <div class="payment-sepay-preview__qr">
                            <img src="" alt="Mã QR SePay" data-sepay-qr hidden />
                            <div class="payment-sepay-preview__placeholder" data-sepay-placeholder>
                                <strong>SePay QR</strong>
                                <span>Bấm cọc hoặc thanh toán toàn bộ để tạo mã QR</span>
                            </div>
                        </div>

                        <div class="payment-sepay-preview__info">
                            <div>
                                <span>Ngân hàng</span>
                                <strong>@Model.BankName</strong>
                            </div>
                            <div>
                                <span>Số tài khoản</span>
                                <strong>@Model.BankAccountNo</strong>
                            </div>
                            <div>
                                <span>Chủ tài khoản</span>
                                <strong>@Model.BankAccountName</strong>
                            </div>
                            <div>
                                <span>Nội dung chuyển khoản</span>
                                <strong data-sepay-content>Tạo giao dịch để nhận mã chuyển khoản</strong>
                                <button type="button" class="payment-copy-btn" data-sepay-copy hidden>Sao chép</button>
                            </div>
                            <div>
                                <span>Số tiền</span>
                                <strong data-sepay-amount>Chưa tạo giao dịch</strong>
                            </div>
                            <p data-sepay-message>Lưu ý: Vui lòng nhập đúng nội dung chuyển khoản để hệ thống tự động xác nhận.</p>
                        </div>
                    </div>
                </section>

                <div class="payment-security-strip">
                    <strong>ChillTour cam kết bảo mật tuyệt đối thông tin thanh toán của bạn.</strong>
                    <span>Chúng tôi không lưu trữ thông tin tài khoản ngân hàng của bạn.</span>
                </div>
            </main>

            <aside class="payment-redesign-sidebar">
                <section class="payment-redesign-panel payment-total-card">
                    <h2>Chi tiết thanh toán</h2>
                    <div class="payment-total-lines">
                        <div>
                            <span>Tiền tour</span>
                            <strong>@Model.BaseAmount.ToString("N0") đ</strong>
                        </div>
                        <div>
                            <span>Phụ thu phòng đơn</span>
                            <strong>@Model.SingleRoomSupplementAmount.ToString("N0") đ</strong>
                        </div>
                        @if (totalDiscount > 0m)
                        {
                            <div class="is-discount">
                                <span>Giảm giá</span>
                                <strong>-@totalDiscount.ToString("N0") đ</strong>
                            </div>
                        }
                    </div>
                    <div class="payment-total-final">
                        <span>Tổng tiền</span>
                        <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>

                    <div class="payment-total-note">
                        Bạn có thể chọn cọc 30% hoặc thanh toán toàn bộ.
                    </div>

                    <h3>Thanh toán nhanh</h3>
                    <div class="payment-fast-actions">
                        @if (isCancelled)
                        {
                            <div class="auth-alert auth-alert--error">Đơn này đã hủy, không thể tiếp tục thanh toán.</div>
                        }
                        else if (Model.CanCancelPendingBooking)
                        {
                            <form asp-action="CancelPendingBooking" method="post"
                                  onsubmit="return confirm('Hủy đơn nháp này? Đơn chưa thanh toán sẽ không được tính là đã đặt tour.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <button type="submit" class="btn btn-outline-secondary">Hủy đơn nháp</button>
                            </form>
                        }

                        @if (!isCancelled && Model.CanPayDeposit)
                        {
                            <form asp-action="StartSePayInline" method="post" data-sepay-start-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <input type="hidden" name="paymentMode" value="deposit" />
                                <button type="submit" class="btn btn-outline-primary">Cọc 30% (@Model.DepositAmount.ToString("N0") đ)</button>
                            </form>
                        }

                        @if (!isCancelled && Model.CanPayFull)
                        {
                            <form asp-action="StartSePayInline" method="post" data-sepay-start-form>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                <input type="hidden" name="paymentMode" value="full" />
                                <button type="submit" class="btn btn-primary">Thanh toán toàn bộ (@Model.FullPaymentAmount.ToString("N0") đ)</button>
                            </form>
                        }
                        else if (!isCancelled)
                        {
                            <div class="auth-alert auth-alert--success">Đơn này đã thanh toán đầy đủ.</div>
                        }
                    </div>

                    <p class="payment-terms-note">Bằng việc thanh toán, bạn đồng ý với Điều khoản và điều kiện của ChillTour.</p>
                </section>

                <section class="payment-redesign-panel payment-guide-card">
                    <h2>Hướng dẫn thanh toán SePay</h2>
                    <ol>
                        <li><strong>Mở ứng dụng ngân hàng</strong><span>Chọn tính năng quét VietQR.</span></li>
                        <li><strong>Quét mã QR</strong><span>Kiểm tra đúng số tiền và nội dung.</span></li>
                        <li><strong>Xác nhận chuyển khoản</strong><span>Hoàn tất giao dịch trên app ngân hàng.</span></li>
                        <li><strong>Chờ xác nhận</strong><span>Hệ thống sẽ tự động ghi nhận trong vài phút.</span></li>
                    </ol>
                </section>

                <section class="payment-redesign-panel payment-support-card">
                    <h2>Bạn cần hỗ trợ?</h2>
                    <p>Hotline: <strong>1900 1234</strong></p>
                    <p>Email: <strong>support@chilltour.vn</strong></p>
                    <p>Chat trực tuyến sẵn sàng hỗ trợ 24/7.</p>
                </section>
            </aside>
        </div>

        <div class="payment-redesign-footnote">
            Sau khi thanh toán thành công, bạn sẽ nhận được email xác nhận và vé điện tử trong vòng 5 phút.
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const qrImage = document.querySelector('[data-sepay-qr]');
            const placeholder = document.querySelector('[data-sepay-placeholder]');
            const content = document.querySelector('[data-sepay-content]');
            const amount = document.querySelector('[data-sepay-amount]');
            const message = document.querySelector('[data-sepay-message]');
            const copyButton = document.querySelector('[data-sepay-copy]');
            let pollingTimer = null;

            const setMessage = (text, state = 'info') => {
                if (!message) return;
                message.textContent = text;
                message.dataset.state = state;
            };

            const startPolling = (statusUrl, fallbackResultUrl) => {
                if (!statusUrl) return;
                window.clearInterval(pollingTimer);

                pollingTimer = window.setInterval(async () => {
                    try {
                        const response = await fetch(statusUrl, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await response.json();

                        if (data.message) {
                            setMessage(data.message, data.failed ? 'error' : data.success ? 'success' : 'info');
                        }

                        if (data.failed) {
                            window.clearInterval(pollingTimer);
                            return;
                        }

                        if (data.success && (data.resultUrl || fallbackResultUrl)) {
                            window.clearInterval(pollingTimer);
                            window.location.href = data.resultUrl || fallbackResultUrl;
                        }
                    } catch {
                        setMessage('Chưa kiểm tra được trạng thái thanh toán. Hệ thống sẽ thử lại sau vài giây.', 'error');
                    }
                }, 3000);
            };

            document.querySelectorAll('[data-sepay-start-form]').forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const submitButton = form.querySelector('button[type="submit"]');
                    const originalText = submitButton?.textContent;

                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Đang tạo QR...';
                    }

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            setMessage(data.message || 'Không thể tạo mã QR SePay.', 'error');
                            return;
                        }

                        if (qrImage) {
                            qrImage.src = data.qrImageUrl;
                            qrImage.hidden = false;
                        }
                        if (placeholder) {
                            placeholder.hidden = true;
                        }
                        if (content) {
                            content.textContent = data.transferContent;
                        }
                        if (amount) {
                            amount.textContent = data.amount;
                        }
                        if (copyButton) {
                            copyButton.hidden = false;
                            copyButton.dataset.copyText = data.transferContent;
                        }

                        setMessage(data.message || 'Đã tạo QR SePay. Vui lòng chuyển khoản đúng nội dung.', 'success');
                        document.querySelector('[data-sepay-preview]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        startPolling(data.statusUrl, data.resultUrl);
                    } catch {
                        setMessage('Có lỗi khi tạo mã QR. Vui lòng thử lại.', 'error');
                    } finally {
                        if (submitButton) {
                            submitButton.disabled = false;
                            submitButton.textContent = originalText;
                        }
                    }
                });
            });

            copyButton?.addEventListener('click', async () => {
                const text = copyButton.dataset.copyText || '';
                if (!text) return;

                try {
                    await navigator.clipboard.writeText(text);
                    const original = copyButton.textContent;
                    copyButton.textContent = 'Đã sao chép';
                    window.setTimeout(() => {
                        copyButton.textContent = original;
                    }, 1600);
                } catch {
                    copyButton.textContent = 'Không thể sao chép';
                }
            });
        })();
    </script>
}
