@model IReadOnlyList<ChillTour.Models.Admin.AdminDestinationItemViewModel>
@{
    ViewData["Title"] = "Điểm đến";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Catalog</span>
            <h2>Điểm đến</h2>
        </div>
        <a asp-action="CreateDestination" class="btn btn-primary nav-cta">Thêm điểm đến</a>
    </div>

    @if (TempData["AdminSuccessMessage"] is string successMessage)
    {
        <div class="auth-alert auth-alert--success">@successMessage</div>
    }
    @if (TempData["AdminErrorMessage"] is string errorMessage)
    {
        <div class="auth-alert auth-alert--error">@errorMessage</div>
    }

    <section class="admin-panel">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên điểm đến</th>
                        <th>Loại</th>
                        <th>Quốc gia</th>
                        <th>Tỉnh/Thành</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">Chưa có điểm đến nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.DestinationCode</strong></td>
                                <td>
                                    <strong>@item.DestinationName</strong>
                                    @if (item.IsFeatured)
                                    {
                                        <div class="admin-table__sub">Điểm nổi bật</div>
                                    }
                                </td>
                                <td>@(item.DestinationType switch { 1 => "Thành phố", 2 => "Điểm tham quan", 3 => "Quốc gia", 4 => "Khác", _ => "Khác" })</td>
                                <td>@item.CountryCode</td>
                                <td>@(string.IsNullOrWhiteSpace(item.ProvinceName) ? "-" : item.ProvinceName)</td>
                                <td>
                                    <span class="status-pill @(item.IsActive ? "status-pill--success" : "status-pill--danger")">
                                        @(item.IsActive ? "Đang dùng" : "Ngừng dùng")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="EditDestination" asp-route-id="@item.DestinationId" class="btn btn-outline-primary btn-sm">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
