@model ChillTour.Models.Admin.AdminDestinationListViewModel
@{
    ViewData["Title"] = "Điểm đến";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Catalog</span>
            <h2>Điểm đến</h2>
        </div>
        <a asp-action="CreateDestination" class="btn btn-primary nav-cta">Thêm điểm đến</a>
    </div>

    @if (TempData["AdminSuccessMessage"] is string successMessage)
    {
        <div class="auth-alert auth-alert--success">@successMessage</div>
    }
    @if (TempData["AdminErrorMessage"] is string errorMessage)
    {
        <div class="auth-alert auth-alert--error">@errorMessage</div>
    }

    <section class="admin-panel">
        <form method="get" class="admin-form-grid app-filter-row mb-4">
            <label>
                Từ khóa
                <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Mã, tên điểm đến, quốc gia..." />
            </label>
            <label>
                Loại
                <select name="destinationType" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="1" selected="@(Model.Filter.DestinationType == 1)">Thành phố</option>
                    <option value="2" selected="@(Model.Filter.DestinationType == 2)">Điểm tham quan</option>
                    <option value="3" selected="@(Model.Filter.DestinationType == 3)">Quốc gia</option>
                    <option value="4" selected="@(Model.Filter.DestinationType == 4)">Khác</option>
                </select>
            </label>
            <label>
                Quốc gia
                <input type="text" name="countryCode" value="@Model.Filter.CountryCode" class="form-control" placeholder="VN, TH, SG..." />
            </label>
            <label>
                Nổi bật
                <select name="isFeatured" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsFeatured == true)">Nổi bật</option>
                    <option value="false" selected="@(Model.Filter.IsFeatured == false)">Thường</option>
                </select>
            </label>
            <label>
                Trạng thái
                <select name="isActive" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Đang dùng</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Ngừng dùng</option>
                </select>
            </label>
            <div class="hero-actions align-items-end">
                <button type="submit" class="btn btn-primary">Lọc điểm đến</button>
                <a asp-action="Destinations" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên điểm đến</th>
                        <th>Loại</th>
                        <th>Quốc gia</th>
                        <th>Tỉnh/Thành</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Destinations.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">Không có điểm đến phù hợp với bộ lọc hiện tại.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Destinations)
                        {
                            <tr>
                                <td><strong>@item.DestinationCode</strong></td>
                                <td>
                                    <strong>@item.DestinationName</strong>
                                    @if (item.IsFeatured)
                                    {
                                        <div class="admin-table__sub">Điểm nổi bật</div>
                                    }
                                </td>
                                <td>@(item.DestinationType switch { 1 => "Thành phố", 2 => "Điểm tham quan", 3 => "Quốc gia", 4 => "Khác", _ => "Khác" })</td>
                                <td>@item.CountryCode</td>
                                <td>@(string.IsNullOrWhiteSpace(item.ProvinceName) ? "-" : item.ProvinceName)</td>
                                <td>
                                    <span class="status-pill @(item.IsActive ? "status-pill--success" : "status-pill--danger")">
                                        @(item.IsActive ? "Đang dùng" : "Ngừng dùng")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="EditDestination" asp-route-id="@item.DestinationId" class="btn btn-outline-primary btn-sm">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
