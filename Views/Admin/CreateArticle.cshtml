@model ChillTour.Models.Admin.ArticleFormViewModel
@{
    ViewData["Title"] = "Thêm cẩm nang";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Guide Management</span>
            <h2>Tạo bài cẩm nang</h2>
            <p>Nhập tiêu đề, nội dung và ảnh thumbnail để hiển thị trên trang cẩm nang.</p>
        </div>
        <a asp-action="Articles" class="btn btn-outline-primary">Quay lại</a>
    </div>

    <div class="admin-panel">
        <form asp-action="CreateArticle" method="post">
            @Html.AntiForgeryToken()
            <partial name="_ArticleForm" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu bài viết</button>
                <a asp-action="Articles" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
