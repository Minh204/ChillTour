@model ChillTour.Models.Admin.AdminTourListViewModel
@{
    ViewData["Title"] = "Quản lý tour";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Tour Management</span>
            <h2>Danh sách tour</h2>
        </div>
        <a asp-action="CreateTour" class="btn btn-primary nav-cta">Thêm tour</a>
    </div>

    @if (TempData["AdminSuccessMessage"] is string successMessage)
    {
        <div class="auth-alert auth-alert--success">@successMessage</div>
    }
    @if (TempData["AdminErrorMessage"] is string errorMessage)
    {
        <div class="auth-alert auth-alert--error">@errorMessage</div>
    }

    <section class="admin-panel">
        <form method="get" class="admin-form-grid app-filter-row mb-4">
            <input type="hidden" name="page" value="1" />
            <label>
                Từ khóa
                <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Mã tour, tên tour, tuyến..." />
            </label>
            <label>
                Danh mục
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var item in Model.CategoryOptions)
                    {
                        <option value="@item.Id" selected="@(Model.Filter.CategoryId == item.Id)">@item.Name</option>
                    }
                </select>
            </label>
            <label>
                Xuất bản
                <select name="isPublished" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsPublished == true)">Đã xuất bản</option>
                    <option value="false" selected="@(Model.Filter.IsPublished == false)">Nháp</option>
                </select>
            </label>
            <label>
                Nổi bật
                <select name="isFeatured" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsFeatured == true)">Nổi bật</option>
                    <option value="false" selected="@(Model.Filter.IsFeatured == false)">Thường</option>
                </select>
            </label>
            <label>
                Lịch khởi hành
                <select name="scheduleState" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="upcoming" selected="@(Model.Filter.ScheduleState == "upcoming")">Còn lịch sắp tới</option>
                    <option value="expired" selected="@(Model.Filter.ScheduleState == "expired")">Tất cả lịch đã quá hạn</option>
                </select>
            </label>
            <div class="hero-actions align-items-end">
                <button type="submit" class="btn btn-primary">Lọc tour</button>
                <a asp-action="Tours" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã tour</th>
                        <th>Tên tour</th>
                        <th>Danh mục</th>
                        <th>Tuyến</th>
                        <th>Thời lượng</th>
                        <th>Giá từ</th>
                        <th>Lịch</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Tours.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4">Không có tour phù hợp với bộ lọc hiện tại.</td>
                    </tr>
                }
                else
                {
                    @foreach (var tour in Model.Tours)
                    {
                        <tr>
                            <td><strong>@tour.TourCode</strong></td>
                            <td>
                                <strong>@tour.TourName</strong>
                                <div class="admin-table__sub">Tạo lúc @tour.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>@tour.CategoryName</td>
                            <td>@tour.RouteName</td>
                            <td>@tour.DurationDays ngày</td>
                            <td>@tour.BasePrice.ToString("N0") đ</td>
                            <td>
                                @if (tour.HasOnlyExpiredSchedules)
                                {
                                    <span class="status-pill status-pill--danger">Đã quá hạn toàn bộ</span>
                                }
                                else if (tour.NextDepartureDate.HasValue)
                                {
                                    <span class="status-pill status-pill--success">@tour.NextDepartureDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--warning">Chưa có lịch</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-2">
                                    <span class="status-pill @(tour.IsPublished ? "status-pill--success" : "status-pill--danger")">
                                        @(tour.IsPublished ? "Đã xuất bản" : "Nháp")
                                    </span>
                                    @if (tour.IsFeatured)
                                    {
                                        <span class="status-pill status-pill--info">Nổi bật</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="admin-inline-form">
                                    <a asp-action="EditTour" asp-route-id="@tour.TourId" class="btn btn-outline-primary btn-sm">Sửa</a>
                                    <form asp-action="DeleteTour" method="post" onsubmit="return confirm('Xóa tour này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tour.TourId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="admin-pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Tours" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-isPublished="@Model.Filter.IsPublished" asp-route-isFeatured="@Model.Filter.IsFeatured" asp-route-scheduleState="@Model.Filter.ScheduleState" class="admin-pagination__link">Trước</a>
                }
                else
                {
                    <span class="admin-pagination__link is-disabled">Trước</span>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a asp-action="Tours" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-isPublished="@Model.Filter.IsPublished" asp-route-isFeatured="@Model.Filter.IsFeatured" asp-route-scheduleState="@Model.Filter.ScheduleState" class="admin-pagination__link @(pageNumber == Model.CurrentPage ? "is-active" : "")">@pageNumber</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Tours" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-isPublished="@Model.Filter.IsPublished" asp-route-isFeatured="@Model.Filter.IsFeatured" asp-route-scheduleState="@Model.Filter.ScheduleState" class="admin-pagination__link">Sau</a>
                }
                else
                {
                    <span class="admin-pagination__link is-disabled">Sau</span>
                }
            </div>
        }
    </section>
</section>
