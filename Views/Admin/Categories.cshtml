@model ChillTour.Models.Admin.AdminCategoryListViewModel
@{
    ViewData["Title"] = "Danh mục tour";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Catalog</span>
            <h2>Danh mục tour</h2>
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary nav-cta">Thêm danh mục</a>
    </div>

    @if (TempData["AdminSuccessMessage"] is string successMessage)
    {
        <div class="auth-alert auth-alert--success">@successMessage</div>
    }
    @if (TempData["AdminErrorMessage"] is string errorMessage)
    {
        <div class="auth-alert auth-alert--error">@errorMessage</div>
    }

    <section class="admin-panel">
        <form method="get" class="admin-form-grid mb-4">
            <label>
                Từ khóa
                <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Mã, tên danh mục..." />
            </label>
            <label>
                Trạng thái
                <select name="isActive" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Đang dùng</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Ngừng dùng</option>
                </select>
            </label>
            <div class="hero-actions align-items-end">
                <button type="submit" class="btn btn-primary">Lọc danh mục</button>
                <a asp-action="Categories" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên danh mục</th>
                        <th>Thứ tự</th>
                        <th>Tour đang dùng</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">Không có danh mục phù hợp với bộ lọc hiện tại.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td><strong>@item.CategoryCode</strong></td>
                                <td>@item.CategoryName</td>
                                <td>@item.DisplayOrder</td>
                                <td>@item.TourCount</td>
                                <td>
                                    <span class="status-pill @(item.IsActive ? "status-pill--success" : "status-pill--danger")">
                                        @(item.IsActive ? "Đang dùng" : "Ngừng dùng")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="EditCategory" asp-route-id="@item.CategoryId" class="btn btn-outline-primary btn-sm">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
