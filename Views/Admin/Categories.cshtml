@model ChillTour.Models.Admin.AdminCategoryListViewModel
@{
    ViewData["Title"] = "Danh mục tour";
}

<section class="admin-page-stack">
    <div class="admin-page-head">
        <div>
            <span class="admin-panel__label">Catalog</span>
            <h2>Danh mục tour</h2>
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary nav-cta">Thêm danh mục</a>
    </div>

    <section class="admin-panel">
        <form method="get" class="admin-form-grid app-filter-row mb-4">
            <label>
                Từ khóa
                <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Mã, tên danh mục..." />
            </label>
            <label>
                Trạng thái
                <select name="isActive" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Đang dùng</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Ngừng dùng</option>
                </select>
            </label>
            <div class="hero-actions align-items-end">
                <button type="submit" class="btn btn-primary">Lọc danh mục</button>
                <a asp-action="Categories" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên danh mục</th>
                        <th>Thứ tự</th>
                        <th>Đang sử dụng</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">Không có danh mục phù hợp với bộ lọc hiện tại.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td><strong>@item.CategoryCode</strong></td>
                                <td>@item.CategoryName</td>
                                <td>@item.DisplayOrder</td>
                                <td>
                                    <div>@item.TourCount tour</div>
                                    @if (item.ChildCategoryCount > 0)
                                    {
                                        <small class="text-muted">@item.ChildCategoryCount danh mục con</small>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(item.IsActive ? "status-pill--success" : "status-pill--danger")">
                                        @(item.IsActive ? "Đang dùng" : "Ngừng dùng")
                                    </span>
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        <a asp-action="EditCategory" asp-route-id="@item.CategoryId" class="btn btn-outline-primary btn-sm">Sửa</a>
                                        <form asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post" class="d-inline"
                                              onsubmit="return confirm('@(item.IsInUse ? "Danh mục này đang được sử dụng nên hệ thống sẽ chỉ vô hiệu hóa. Bạn muốn tiếp tục?" : "Danh mục này chưa được sử dụng và sẽ bị xóa vĩnh viễn. Bạn muốn tiếp tục?")');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                @(item.IsInUse ? "Vô hiệu hóa" : "Xóa")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="admin-pagination">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Categories" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-isActive="@Model.Filter.IsActive" class="admin-pagination__link">Trước</a>
                }
                else
                {
                    <span class="admin-pagination__link is-disabled">Trước</span>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a asp-action="Categories" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-isActive="@Model.Filter.IsActive" class="admin-pagination__link @(pageNumber == Model.CurrentPage ? "is-active" : "")">@pageNumber</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Categories" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-isActive="@Model.Filter.IsActive" class="admin-pagination__link">Sau</a>
                }
                else
                {
                    <span class="admin-pagination__link is-disabled">Sau</span>
                }
            </div>
        }
    </section>
</section>
