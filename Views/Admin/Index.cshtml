@model ChillTour.Models.Admin.AdminDashboardViewModel
@using System.Globalization
@using System.Text

@functions {
    private static readonly CultureInfo Vi = new("vi-VN");

    private string Money(decimal amount) => string.Format(Vi, "{0:N0} đ", amount);

    private string LinePath(IReadOnlyList<decimal> values, double width = 760, double height = 230, double pad = 26)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var max = values.Max();
        var innerWidth = Math.Max(width - (pad * 2), 1);
        var innerHeight = Math.Max(height - (pad * 2), 1);
        var step = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var path = new StringBuilder();

        for (var i = 0; i < values.Count; i++)
        {
            var ratio = max <= 0 ? 0 : (double)(values[i] / max);
            var x = pad + (step * i);
            var y = height - pad - (innerHeight * ratio);
            path.Append(i == 0 ? "M " : " L ");
            path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
        }

        return path.ToString();
    }

    private string AreaPath(IReadOnlyList<decimal> values, double width = 760, double height = 230, double pad = 26)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var innerWidth = Math.Max(width - (pad * 2), 1);
        var step = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var startX = pad;
        var endX = pad + (step * (values.Count - 1));
        var baseY = height - pad;
        return $"{LinePath(values, width, height, pad)} L {endX.ToString("0.##", CultureInfo.InvariantCulture)} {baseY.ToString("0.##", CultureInfo.InvariantCulture)} L {startX.ToString("0.##", CultureInfo.InvariantCulture)} {baseY.ToString("0.##", CultureInfo.InvariantCulture)} Z";
    }

    private string Percent(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}

@{
    ViewData["Title"] = "Dashboard";

    var revenueValues = Model.DailyMetrics.Select(x => x.DepositRevenue).ToList();
    var bookingValues = Model.DailyMetrics.Select(x => (decimal)x.BookingCount).ToList();
    var customerValues = Model.DailyMetrics.Select(x => (decimal)x.UserCount).ToList();
    var activeBookings = Math.Max(Model.TotalBookings - Model.CancelledBookings, 0);
    var maxTopTourBookings = Model.TopTours.Count == 0 ? 0 : Model.TopTours.Max(x => x.BookingCount);
    var paidPct = Model.TotalBookings == 0 ? 0m : Math.Round(Model.PaidBookings * 100m / Model.TotalBookings, 1);
    var cancelledPct = Model.TotalBookings == 0 ? 0m : Math.Round(Model.CancelledBookings * 100m / Model.TotalBookings, 1);
    var pendingPct = Math.Max(0, 100 - paidPct - cancelledPct);
    var confirmPct = Math.Clamp(Model.ConfirmationRate, 0, 100);
    var dashboardPeriod = (ViewBag.DashboardPeriod as string) ?? "week";
    var metricLabelFormat = dashboardPeriod == "year" ? "MM/yyyy" : "dd/MM";
}

<section class="admin-analytics-shell">
    <div class="admin-analytics-head">
        <div>
            <span class="admin-chip">Dashboard</span>
            <h1>Tổng quan vận hành</h1>
        </div>
        <div class="admin-analytics-actions">
            <a asp-action="Reports" class="btn btn-primary">Mở báo cáo</a>
        </div>
    </div>

    <section class="admin-kpi-grid">
        <article class="admin-kpi-card">
            <span>Tổng doanh thu</span>
            <strong>@Money(Model.DepositRevenue)</strong>
            <small>Dự kiến @Money(Model.ExpectedRevenue)</small>
        </article>
        <article class="admin-kpi-card">
            <span>Tổng booking</span>
            <strong>@Model.TotalBookings</strong>
            <small>@Model.PendingBookings đơn cần xử lý</small>
        </article>
        <article class="admin-kpi-card">
            <span>Khách hàng</span>
            <strong>@Model.TotalUsers</strong>
            <small>+@Model.NewUsersThisWeek trong tuần</small>
        </article>
        <article class="admin-kpi-card">
            <span>Tour đang bán</span>
            <strong>@Model.PublishedTours</strong>
            <small>@Model.UpcomingSchedules lịch mở bán</small>
        </article>
    </section>

    <section class="admin-chart-grid">
        <article class="admin-chart-card admin-chart-card--wide">
            <header class="admin-chart-head">
                <div>
                    <span>Revenue</span>
                    <h2>Doanh thu theo thời gian</h2>
                </div>
                <form asp-action="Index" method="get" class="admin-chart-period-form">
                    <select name="period" class="admin-chart-select" aria-label="Chu kỳ doanh thu" onchange="this.form.submit()">
                        <option value="week" selected="@(dashboardPeriod == "week")">Tuần này</option>
                        <option value="month" selected="@(dashboardPeriod == "month")">Tháng này</option>
                        <option value="year" selected="@(dashboardPeriod == "year")">Năm nay</option>
                    </select>
                </form>
            </header>
            <svg class="admin-svg-chart" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ đường doanh thu">
                <defs>
                    <linearGradient id="dashboardRevenueArea" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="#5b8cff" stop-opacity=".32" />
                        <stop offset="100%" stop-color="#5b8cff" stop-opacity=".04" />
                    </linearGradient>
                </defs>
                @for (var row = 0; row < 5; row++)
                {
                    var y = 26 + (178d / 4 * row);
                    <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                }
                <path d="@AreaPath(revenueValues)" class="admin-svg-area"></path>
                <path d="@LinePath(revenueValues)" class="admin-svg-line admin-svg-line--blue"></path>
            </svg>
            <div class="admin-chart-labels">
                @foreach (var item in Model.DailyMetrics)
                {
                    <span>@item.Date.ToString(metricLabelFormat)</span>
                }
            </div>
        </article>

        <article class="admin-gauge-card">
            <header class="admin-chart-head">
                <div>
                    <span>Success</span>
                    <h2>Tỷ lệ xác nhận</h2>
                </div>
            </header>
            <div class="admin-gauge" style="--value:@Percent(confirmPct)">
                <strong>@confirmPct.ToString("N1", Vi)%</strong>
                <span>booking hợp lệ</span>
            </div>
            <div class="admin-mini-stats">
                <div><b>@Model.ConfirmedBookings</b><span>Đã xác nhận</span></div>
                <div><b>@Model.LowSeatSchedules</b><span>Sắp hết chỗ</span></div>
            </div>
        </article>
    </section>

    <section class="admin-chart-grid admin-chart-grid--thirds">
        <article class="admin-chart-card">
            <header class="admin-chart-head">
                <div>
                    <span>Booking</span>
                    <h2>Booking rate</h2>
                </div>
                <form asp-action="Index" method="get" class="admin-chart-period-form">
                    <select name="period" class="admin-chart-select" aria-label="Chu kỳ booking" onchange="this.form.submit()">
                        <option value="week" selected="@(dashboardPeriod == "week")">Tuần này</option>
                        <option value="month" selected="@(dashboardPeriod == "month")">Tháng này</option>
                        <option value="year" selected="@(dashboardPeriod == "year")">Năm nay</option>
                    </select>
                </form>
            </header>
            <svg class="admin-svg-chart admin-svg-chart--compact" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ booking">
                @for (var row = 0; row < 5; row++)
                {
                    var y = 26 + (178d / 4 * row);
                    <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                }
                <path d="@LinePath(bookingValues)" class="admin-svg-line admin-svg-line--green"></path>
            </svg>
        </article>

        <article class="admin-chart-card">
            <header class="admin-chart-head">
                <div>
                    <span>Customer</span>
                    <h2>Khách hàng mới</h2>
                </div>
                <form asp-action="Index" method="get" class="admin-chart-period-form">
                    <select name="period" class="admin-chart-select" aria-label="Chu kỳ khách hàng" onchange="this.form.submit()">
                        <option value="week" selected="@(dashboardPeriod == "week")">Tuần này</option>
                        <option value="month" selected="@(dashboardPeriod == "month")">Tháng này</option>
                        <option value="year" selected="@(dashboardPeriod == "year")">Năm nay</option>
                    </select>
                </form>
            </header>
            <svg class="admin-svg-chart admin-svg-chart--compact" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ khách hàng">
                @for (var row = 0; row < 5; row++)
                {
                    var y = 26 + (178d / 4 * row);
                    <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                }
                <path d="@LinePath(customerValues)" class="admin-svg-line admin-svg-line--orange"></path>
            </svg>
        </article>

        <article class="admin-chart-card">
            <header class="admin-chart-head">
                <div>
                    <span>Status</span>
                    <h2>Cơ cấu đơn</h2>
                </div>
            </header>
            <div class="admin-donut-row">
                <div class="admin-donut" style="background:conic-gradient(#20c997 0 @Percent(paidPct)%, #ffcf4a @Percent(paidPct)% @Percent(paidPct + pendingPct)%, #ff6b6b 0);">
                    <strong>@Model.TotalBookings</strong>
                    <span>đơn</span>
                </div>
                <div class="admin-legend-list">
                    <span><i style="background:#20c997"></i>Đã thu tiền: @Model.PaidBookings</span>
                    <span><i style="background:#ffcf4a"></i>Đang xử lý: @Model.PendingBookings</span>
                    <span><i style="background:#ff6b6b"></i>Đã hủy: @Model.CancelledBookings</span>
                </div>
            </div>
        </article>
    </section>

    <section class="admin-chart-grid">
        <article class="admin-chart-card">
            <header class="admin-chart-head">
                <div>
                    <span>Top tours</span>
                    <h2>Tour bán chạy</h2>
                </div>
            </header>
            <div class="admin-bar-list">
                @foreach (var tour in Model.TopTours.Take(5))
                {
                    <div class="admin-bar-row">
                        <span>@tour.TourName</span>
                        <b>@tour.BookingCount</b>
                        <i style="width:@(maxTopTourBookings <= 0 ? 8 : Math.Max(8, (int)Math.Round(tour.BookingCount * 100m / maxTopTourBookings)))%"></i>
                    </div>
                }
            </div>
        </article>

        <article class="admin-chart-card">
            <header class="admin-chart-head">
                <div>
                    <span>Departures</span>
                    <h2>Lịch khởi hành gần nhất</h2>
                </div>
            </header>
            <div class="admin-compact-table">
                @foreach (var item in Model.UpcomingDepartures.Take(6))
                {
                    <div>
                        <strong>@item.TourName</strong>
                        <span>@item.DepartureDate.ToString("dd/MM/yyyy")</span>
                        <b>@item.AvailableSeats/@item.TotalSeats chỗ</b>
                    </div>
                }
            </div>
        </article>
    </section>
</section>
