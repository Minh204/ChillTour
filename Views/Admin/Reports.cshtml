@model ChillTour.Models.Admin.AdminReportPageViewModel
@using System.Globalization
@using System.Text

@functions {
    private static readonly CultureInfo Vi = new("vi-VN");

    private string Money(decimal amount) => string.Format(Vi, "{0:N0} đ", amount);
    private string MoneyShort(decimal amount) => amount >= 1000000000m
        ? $"{(amount / 1000000000m).ToString("0.#", Vi)}B"
        : amount >= 1000000m
            ? $"{(amount / 1000000m).ToString("0.#", Vi)}M"
            : amount >= 1000m
                ? $"{(amount / 1000m).ToString("0.#", Vi)}K"
                : amount.ToString("0", Vi);
    private string Number(decimal value) => value.ToString("N1", Vi);
    private string Invariant(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private int Bar(decimal value, decimal max) => max <= 0 ? 8 : Math.Max(8, (int)Math.Round(value * 100m / max));

    private string LinePath(IReadOnlyList<decimal> values, double width = 760, double height = 230, double pad = 26)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var max = values.Max();
        var innerWidth = Math.Max(width - (pad * 2), 1);
        var innerHeight = Math.Max(height - (pad * 2), 1);
        var step = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var path = new StringBuilder();

        for (var i = 0; i < values.Count; i++)
        {
            var ratio = max <= 0 ? 0 : (double)(values[i] / max);
            var x = pad + (step * i);
            var y = height - pad - (innerHeight * ratio);
            path.Append(i == 0 ? "M " : " L ");
            path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
        }

        return path.ToString();
    }

    private string AreaPath(IReadOnlyList<decimal> values, double width = 760, double height = 230, double pad = 26)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var innerWidth = Math.Max(width - (pad * 2), 1);
        var step = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var startX = pad;
        var endX = pad + (step * (values.Count - 1));
        var baseY = height - pad;
        return $"{LinePath(values, width, height, pad)} L {endX.ToString("0.##", CultureInfo.InvariantCulture)} {baseY.ToString("0.##", CultureInfo.InvariantCulture)} L {startX.ToString("0.##", CultureInfo.InvariantCulture)} {baseY.ToString("0.##", CultureInfo.InvariantCulture)} Z";
    }
}

@{
    ViewData["Title"] = "Báo cáo & thống kê";

    var canAdminAll = string.Equals(Model.RoleLabel, "Admin", StringComparison.OrdinalIgnoreCase);
    var canRevenue = Model.CanSeeBusiness || Model.CanSeeFinance;
    var canBooking = Model.CanSeeBusiness || Model.CanSeeOperations || Model.CanSeeStaff;
    var canCustomer = Model.CanSeeCustomer;
    var canTour = Model.CanSeeBusiness || Model.CanSeeOperations || Model.CanSeeStaff;
    var canContract = Model.CanSeeBusiness;
    var canPayment = Model.CanSeeFinance || Model.CanSeeBusiness;
    var canPromotion = canAdminAll;
    var canStaffOps = Model.CanSeeOperations || Model.CanSeeStaff;

    var revenueValues = Model.Summary.RevenueSeries.Select(x => x.Revenue).ToList();
    var bookingValues = Model.Summary.RevenueSeries.Select(x => (decimal)x.BookingCount).ToList();
    var customerValues = Model.Summary.RevenueSeries.Select((_, index) => index == Model.Summary.RevenueSeries.Count - 1 ? (decimal)Model.Summary.NewCustomers : Math.Max(0, Model.Summary.NewCustomers - (Model.Summary.RevenueSeries.Count - index - 1))).ToList();
    var maxTourRevenue = Model.Summary.TopTours.Count == 0 ? 0m : Model.Summary.TopTours.Max(x => x.Revenue);
    var maxDestinationRevenue = Model.Summary.RevenueByDestination.Count == 0 ? 0m : Model.Summary.RevenueByDestination.Max(x => x.Amount);
    var maxPromoRevenue = Model.Summary.PromotionBreakdown.Count == 0 ? 0m : Model.Summary.PromotionBreakdown.Max(x => x.Amount);
    var maxStaffActions = Model.Summary.StaffPerformance.Count == 0 ? 0m : Model.Summary.StaffPerformance.Max(x => (decimal)x.HandledActions);
    var paidPct = Model.Summary.TotalBookings == 0 ? 0m : Math.Round(Model.Summary.PaidBookings * 100m / Model.Summary.TotalBookings, 1);
    var cancelPct = Model.Summary.TotalBookings == 0 ? 0m : Math.Round(Model.Summary.CancelledBookings * 100m / Model.Summary.TotalBookings, 1);
    var pendingPct = Math.Max(0, 100 - paidPct - cancelPct);
    var returningPct = Model.Summary.TotalCustomers == 0 ? 0m : Math.Round(Model.Summary.ReturningCustomers * 100m / Model.Summary.TotalCustomers, 1);
    var contractPct = Math.Clamp(Model.Summary.ContractSignSuccessRate, 0, 100);
    var paymentSuccessPct = Model.Summary.SuccessfulPayments + Model.Summary.FailedPayments == 0 ? 0m : Math.Round(Model.Summary.SuccessfulPayments * 100m / (Model.Summary.SuccessfulPayments + Model.Summary.FailedPayments), 1);
    var currentPeriod = string.IsNullOrWhiteSpace(Model.Filter.Period) ? "month" : Model.Filter.Period;
    var maxRevenueValue = revenueValues.Count == 0 ? 0m : revenueValues.Max();
    var maxBookingValue = bookingValues.Count == 0 ? 0m : bookingValues.Max();
    var maxCustomerValue = customerValues.Count == 0 ? 0m : customerValues.Max();
}

<section class="admin-analytics-shell admin-report-compact admin-dashboard-redesign">
    <div class="admin-analytics-head admin-dashboard-hero">
        <div>
            <span class="admin-chip">@Model.RoleLabel</span>
            <h1>Báo cáo & thống kê</h1>
            <p>@Model.Summary.FromDate.ToString("dd/MM/yyyy") - @Model.Summary.ToDate.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="admin-hero-art" aria-hidden="true"><span></span><i></i><b></b></div>
        <div class="admin-analytics-actions">
            <a asp-action="ExportReportsExcel"
               asp-route-period="@Model.Filter.Period"
               asp-route-fromDate="@Model.Filter.FromDate"
               asp-route-toDate="@Model.Filter.ToDate"
               asp-route-tourId="@Model.Filter.TourId"
               asp-route-bookingStatus="@Model.Filter.BookingStatus"
               asp-route-paymentStatus="@Model.Filter.PaymentStatus"
               asp-route-paymentMethod="@Model.Filter.PaymentMethod"
               asp-route-customerSearch="@Model.Filter.CustomerSearch"
               class="btn btn-outline-primary admin-hero-action admin-hero-action--light">Excel</a>
            <a asp-action="ExportReportsPdf"
               asp-route-period="@Model.Filter.Period"
               asp-route-fromDate="@Model.Filter.FromDate"
               asp-route-toDate="@Model.Filter.ToDate"
               asp-route-tourId="@Model.Filter.TourId"
               asp-route-bookingStatus="@Model.Filter.BookingStatus"
               asp-route-paymentStatus="@Model.Filter.PaymentStatus"
               asp-route-paymentMethod="@Model.Filter.PaymentMethod"
               asp-route-customerSearch="@Model.Filter.CustomerSearch"
               class="btn btn-primary admin-hero-action">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M9 15h6" /><path d="M9 18h4" /></svg>
                PDF
            </a>
        </div>
    </div>

    <form asp-action="Reports" method="get" class="admin-filter-strip app-filter-row">
        <select name="Period" class="form-select">
            <option value="week" selected="@(currentPeriod == "week")">Theo tuần</option>
            <option value="month" selected="@(currentPeriod == "month")">Theo tháng</option>
            <option value="year" selected="@(currentPeriod == "year")">Theo năm</option>
        </select>
        <input name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
        <input name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" class="form-control" type="date" />
        <select name="TourId" asp-items="Model.TourOptions" class="form-select"></select>
        <select name="BookingStatus" asp-items="Model.BookingStatusOptions" class="form-select"></select>
        <select name="PaymentStatus" asp-items="Model.PaymentStatusOptions" class="form-select"></select>
        <input name="CustomerSearch" value="@Model.Filter.CustomerSearch" class="form-control" placeholder="Khách hàng..." />
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-action="Reports" class="btn btn-outline-secondary">Xóa</a>
    </form>

    <section class="admin-kpi-grid admin-kpi-grid--six">
        @if (canRevenue)
        {
            <article class="admin-kpi-card admin-kpi-card--blue">
                <div class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-8" /><path d="M14 7h7v7" /></svg></div>
                <div><span>Doanh thu</span><strong>@Money(Model.Summary.TotalRevenue)</strong><small>▲ Đã thu @Money(Model.Summary.CollectedRevenue)</small></div>
            </article>
        }
        @if (canBooking)
        {
            <article class="admin-kpi-card admin-kpi-card--violet">
                <div class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 2v20" /><path d="M18 6H6" /><path d="M18 18H6" /><path d="M18 6a4 4 0 0 1 0 8H6" /></svg></div>
                <div><span>Booking</span><strong>@Model.Summary.TotalBookings</strong><small>▲ @Model.Summary.NewBookings đơn mới</small></div>
            </article>
        }
        @if (canCustomer)
        {
            <article class="admin-kpi-card admin-kpi-card--green">
                <div class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
                <div><span>Khách hàng</span><strong>@Model.Summary.TotalCustomers</strong><small>▲ @Model.Summary.ReturningCustomers khách quay lại</small></div>
            </article>
        }
        @if (canTour)
        {
            <article class="admin-kpi-card admin-kpi-card--orange">
                <div class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /><path d="M12 12v3" /><path d="M9 12h6" /></svg></div>
                <div><span>Tour / lịch</span><strong>@Model.Summary.ActiveTours</strong><small>▲ @Model.Summary.LowSeatSchedules lịch sắp hết chỗ</small></div>
            </article>
        }
        @if (canPayment)
        {
            <article class="admin-kpi-card"><span>Còn phải thu</span><strong>@Money(Model.Summary.PendingRevenue)</strong><small>Hoàn/lỗi @Money(Model.Summary.RefundedAmount)</small></article>
        }
        @if (canContract)
        {
            <article class="admin-kpi-card"><span>Hợp đồng</span><strong>@Model.Summary.ContractsSigned</strong><small>@Model.Summary.ContractsPending chờ ký</small></article>
        }
        @if (canStaffOps)
        {
            <article class="admin-kpi-card"><span>Cần xử lý</span><strong>@Model.Summary.PendingStaffTasks</strong><small>Booking / vận hành liên quan</small></article>
        }
    </section>

    @if (Model.Summary.Alerts.Count > 0 && (canAdminAll || Model.CanSeeOperations))
    {
        <section class="admin-alert-strip">
            @foreach (var alert in Model.Summary.Alerts.Take(4))
            {
                <article class="admin-alert-pill admin-alert-pill--@alert.Severity">
                    <strong>@alert.Title</strong>
                    <span>@alert.Message</span>
                </article>
            }
        </section>
    }

    @if (canRevenue || canBooking)
    {
        <section class="admin-chart-grid">
            @if (canRevenue)
            {
                <article class="admin-chart-card admin-chart-card--wide">
                    <header class="admin-chart-head">
                        <div>
                            <span>Revenue</span>
                            <h2>Doanh thu theo thời gian</h2>
                        </div>
                        <form asp-action="Reports" method="get" class="admin-chart-period-form">
                            <select name="Period" class="admin-chart-select" onchange="this.form.submit()">
                                <option value="week" selected="@(currentPeriod == "week")">Tuần</option>
                                <option value="month" selected="@(currentPeriod == "month")">Tháng</option>
                                <option value="year" selected="@(currentPeriod == "year")">Năm</option>
                            </select>
                        </form>
                    </header>
                    <svg class="admin-svg-chart" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ doanh thu">
                        <defs>
                            <linearGradient id="reportRevenueArea" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#2f80ed" stop-opacity=".34" />
                                <stop offset="100%" stop-color="#2f80ed" stop-opacity=".04" />
                            </linearGradient>
                        </defs>
                        @for (var row = 0; row < 5; row++)
                        {
                            var y = 26 + (178d / 4 * row);
                            var label = maxRevenueValue <= 0 ? 0 : maxRevenueValue - (maxRevenueValue / 4 * row);
                            @:<text x="2" y="@((y + 4).ToString("0.##", CultureInfo.InvariantCulture))" class="admin-chart-axis-label">@MoneyShort(label)</text>
                            <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                        }
                        <path d="@AreaPath(revenueValues)" class="admin-svg-area"></path>
                        <path d="@LinePath(revenueValues)" class="admin-svg-line admin-svg-line--blue"></path>
                        @for (var i = 0; i < revenueValues.Count; i++)
                        {
                            var step = revenueValues.Count == 1 ? 0 : 708d / (revenueValues.Count - 1);
                            var ratio = maxRevenueValue <= 0 ? 0 : (double)(revenueValues[i] / maxRevenueValue);
                            var x = 26 + (step * i);
                            var y = 204 - (178d * ratio);
                            <circle cx="@x.ToString("0.##", CultureInfo.InvariantCulture)" cy="@y.ToString("0.##", CultureInfo.InvariantCulture)" r="4.5" class="admin-chart-dot admin-chart-dot--blue" />
                            @:<text x="@x.ToString("0.##", CultureInfo.InvariantCulture)" y="@Math.Max(16, y - 10).ToString("0.##", CultureInfo.InvariantCulture)" class="admin-chart-value">@MoneyShort(revenueValues[i])</text>
                        }
                    </svg>
                    <div class="admin-chart-labels">
                        @foreach (var item in Model.Summary.RevenueSeries)
                        {
                            <span>@item.Label</span>
                        }
                    </div>
                </article>
            }

            @if (canBooking)
            {
                <article class="admin-chart-card">
                    <header class="admin-chart-head">
                        <div>
                            <span>Booking</span>
                            <h2>Trạng thái đơn</h2>
                        </div>
                    </header>
                    <div class="admin-donut-row">
                        <div class="admin-donut" style="background:conic-gradient(#20c997 0 @Invariant(paidPct)%, #ffcf4a @Invariant(paidPct)% @Invariant(paidPct + pendingPct)%, #ff6b6b 0);">
                            <strong>@Number(100 - cancelPct)%</strong>
                            <span>hiệu lực</span>
                        </div>
                        <div class="admin-legend-list">
                            @foreach (var item in Model.Summary.BookingStatusBreakdown.Take(5))
                            {
                                <span><i></i>@item.Label: @item.Count</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </section>
    }

    <section class="admin-chart-grid admin-chart-grid--thirds">
        @if (canBooking)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Booking rate</span>
                        <h2>Booking theo kỳ</h2>
                    </div>
                    <form asp-action="Reports" method="get" class="admin-chart-period-form">
                        <select name="Period" class="admin-chart-select" onchange="this.form.submit()">
                            <option value="week" selected="@(currentPeriod == "week")">Tuần</option>
                            <option value="month" selected="@(currentPeriod == "month")">Tháng</option>
                            <option value="year" selected="@(currentPeriod == "year")">Năm</option>
                        </select>
                    </form>
                </header>
                <svg class="admin-svg-chart admin-svg-chart--compact" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ booking">
                    @for (var row = 0; row < 5; row++)
                    {
                        var y = 26 + (178d / 4 * row);
                        var label = maxBookingValue <= 0 ? 0 : maxBookingValue - (maxBookingValue / 4 * row);
                        @:<text x="4" y="@((y + 4).ToString("0.##", CultureInfo.InvariantCulture))" class="admin-chart-axis-label">@label.ToString("0", Vi)</text>
                        <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                    }
                    <path d="@LinePath(bookingValues)" class="admin-svg-line admin-svg-line--green"></path>
                    @for (var i = 0; i < bookingValues.Count; i++)
                    {
                        var step = bookingValues.Count == 1 ? 0 : 708d / (bookingValues.Count - 1);
                        var ratio = maxBookingValue <= 0 ? 0 : (double)(bookingValues[i] / maxBookingValue);
                        var x = 26 + (step * i);
                        var y = 204 - (178d * ratio);
                        <circle cx="@x.ToString("0.##", CultureInfo.InvariantCulture)" cy="@y.ToString("0.##", CultureInfo.InvariantCulture)" r="4.5" class="admin-chart-dot admin-chart-dot--green" />
                        @:<text x="@x.ToString("0.##", CultureInfo.InvariantCulture)" y="@Math.Max(16, y - 10).ToString("0.##", CultureInfo.InvariantCulture)" class="admin-chart-value">@bookingValues[i].ToString("0", Vi)</text>
                    }
                </svg>
            </article>
        }

        @if (canCustomer)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Customers</span>
                        <h2>Khách hàng</h2>
                    </div>
                    <form asp-action="Reports" method="get" class="admin-chart-period-form">
                        <select name="Period" class="admin-chart-select" onchange="this.form.submit()">
                            <option value="week" selected="@(currentPeriod == "week")">Tuần</option>
                            <option value="month" selected="@(currentPeriod == "month")">Tháng</option>
                            <option value="year" selected="@(currentPeriod == "year")">Năm</option>
                        </select>
                    </form>
                </header>
                <svg class="admin-svg-chart admin-svg-chart--compact" viewBox="0 0 760 230" preserveAspectRatio="none" role="img" aria-label="Biểu đồ khách hàng">
                    @for (var row = 0; row < 5; row++)
                    {
                        var y = 26 + (178d / 4 * row);
                        var label = maxCustomerValue <= 0 ? 0 : maxCustomerValue - (maxCustomerValue / 4 * row);
                        @:<text x="4" y="@((y + 4).ToString("0.##", CultureInfo.InvariantCulture))" class="admin-chart-axis-label">@label.ToString("0", Vi)</text>
                        <line x1="26" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="734" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" />
                    }
                    <path d="@LinePath(customerValues)" class="admin-svg-line admin-svg-line--orange"></path>
                    @for (var i = 0; i < customerValues.Count; i++)
                    {
                        var step = customerValues.Count == 1 ? 0 : 708d / (customerValues.Count - 1);
                        var ratio = maxCustomerValue <= 0 ? 0 : (double)(customerValues[i] / maxCustomerValue);
                        var x = 26 + (step * i);
                        var y = 204 - (178d * ratio);
                        <circle cx="@x.ToString("0.##", CultureInfo.InvariantCulture)" cy="@y.ToString("0.##", CultureInfo.InvariantCulture)" r="4.5" class="admin-chart-dot admin-chart-dot--orange" />
                        @:<text x="@x.ToString("0.##", CultureInfo.InvariantCulture)" y="@Math.Max(16, y - 10).ToString("0.##", CultureInfo.InvariantCulture)" class="admin-chart-value">@customerValues[i].ToString("0", Vi)</text>
                    }
                </svg>
                <div class="admin-mini-stats">
                    <div><b>@Model.Summary.NewCustomers</b><span>Khách mới</span></div>
                    <div><b>@Number(returningPct)%</b><span>Quay lại</span></div>
                </div>
            </article>
        }

        @if (canPayment)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Payments</span>
                        <h2>Thanh toán</h2>
                    </div>
                </header>
                <div class="admin-donut-row">
                    <div class="admin-donut admin-donut--small" style="background:conic-gradient(#2f80ed 0 @Invariant(paymentSuccessPct)%, #ff6b6b 0);">
                        <strong>@Number(paymentSuccessPct)%</strong>
                        <span>thành công</span>
                    </div>
                    <div class="admin-legend-list">
                        @foreach (var item in Model.Summary.PaymentMethodBreakdown.Take(4))
                        {
                            <span><i></i>@item.Label: @Money(item.Amount)</span>
                        }
                    </div>
                </div>
            </article>
        }

        @if (canContract)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Contracts</span>
                        <h2>Hợp đồng</h2>
                    </div>
                </header>
                <div class="admin-gauge admin-gauge--compact" style="--value:@Invariant(contractPct)">
                    <strong>@Number(contractPct)%</strong>
                    <span>ký thành công</span>
                </div>
                <div class="admin-mini-stats">
                    <div><b>@Model.Summary.ContractsSigned</b><span>Đã ký</span></div>
                    <div><b>@Model.Summary.ContractsPending</b><span>Chờ ký</span></div>
                </div>
            </article>
        }
    </section>

    @if (canTour)
    {
        <section class="admin-chart-grid">
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Top tours</span>
                        <h2>Hiệu suất tour</h2>
                    </div>
                </header>
                <div class="admin-bar-list">
                    @foreach (var tour in Model.Summary.TopTours.Take(7))
                    {
                        <div class="admin-bar-row">
                            <span>@tour.TourName</span>
                            <b>@tour.BookingCount booking</b>
                            <i style="width:@Bar(tour.Revenue, maxTourRevenue)%"></i>
                        </div>
                    }
                </div>
            </article>

            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Schedules</span>
                        <h2>Tour còn chỗ / hết chỗ</h2>
                    </div>
                </header>
                <div class="admin-compact-table">
                    @foreach (var item in Model.Summary.ScheduleSnapshot.Take(6))
                    {
                        <div>
                            <strong>@item.TourName</strong>
                            <span>@item.DepartureDate.ToString("dd/MM/yyyy")</span>
                            <b>@item.AvailableSeats/@item.TotalSeats chỗ</b>
                        </div>
                    }
                </div>
            </article>
        </section>
    }

    <section class="admin-chart-grid admin-chart-grid--thirds">
        @if (canRevenue && canAdminAll)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Destinations</span>
                        <h2>Doanh thu điểm đến</h2>
                    </div>
                </header>
                <div class="admin-bar-list">
                    @foreach (var item in Model.Summary.RevenueByDestination.Take(7))
                    {
                        <div class="admin-bar-row">
                            <span>@item.Label</span>
                            <b>@Money(item.Amount)</b>
                            <i style="width:@Bar(item.Amount, maxDestinationRevenue)%"></i>
                        </div>
                    }
                </div>
            </article>
        }

        @if (canPromotion)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Promotions</span>
                        <h2>Khuyến mãi</h2>
                    </div>
                </header>
                <div class="admin-bar-list">
                    @foreach (var item in Model.Summary.PromotionBreakdown.Take(5))
                    {
                        <div class="admin-bar-row">
                            <span>@item.Label</span>
                            <b>@item.Count lượt</b>
                            <i style="width:@Bar(item.Amount, maxPromoRevenue)%"></i>
                        </div>
                    }
                </div>
            </article>
        }

        @if (canCustomer)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Customers</span>
                        <h2>@(Model.RoleLabel == "Employee" ? "Khách phụ trách" : "Top khách hàng")</h2>
                    </div>
                </header>
                <div class="admin-compact-table">
                    @foreach (var customer in Model.Summary.TopCustomers.Take(5))
                    {
                        <div>
                            <strong>@customer.CustomerName</strong>
                            <span>@customer.BookingCount booking</span>
                            <b>@Money(customer.TotalSpent)</b>
                        </div>
                    }
                </div>
            </article>
        }

        @if (canStaffOps)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Operations</span>
                        <h2>@(Model.RoleLabel == "Employee" ? "Việc của tôi" : "Hiệu suất nhân viên")</h2>
                    </div>
                </header>
                @if (Model.RoleLabel == "Employee")
                {
                    <div class="admin-compact-table">
                        @foreach (var task in Model.Summary.StaffTasks.Take(5))
                        {
                            <div>
                                <strong>@task.Label</strong>
                                <span>@task.Hint</span>
                                <b>@task.Count</b>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="admin-bar-list">
                        @foreach (var staff in Model.Summary.StaffPerformance.Take(6))
                        {
                            <div class="admin-bar-row">
                                <span>@staff.StaffName</span>
                                <b>@staff.HandledActions lượt</b>
                                <i style="width:@Bar(staff.HandledActions, maxStaffActions)%"></i>
                            </div>
                        }
                    </div>
                }
            </article>
        }

        @if (canPayment)
        {
            <article class="admin-chart-card">
                <header class="admin-chart-head">
                    <div>
                        <span>Finance</span>
                        <h2>Giao dịch gần đây</h2>
                    </div>
                </header>
                <div class="admin-compact-table">
                    @foreach (var item in Model.Summary.RecentTransactions.Take(6))
                    {
                        <div>
                            <strong>@item.BookingCode</strong>
                            <span>@item.PaymentStatusLabel</span>
                            <b>@Money(item.Amount)</b>
                        </div>
                    }
                </div>
            </article>
        }
    </section>
</section>
