@model ChillTour.Models.Admin.AdminReportPageViewModel
@using System.Globalization
@using System.Text

@functions {
    private string BuildLinePath(IReadOnlyList<decimal> values, double width, double height, double padding)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var max = values.Max();
        var innerWidth = Math.Max(width - (padding * 2), 1);
        var innerHeight = Math.Max(height - (padding * 2), 1);
        var stepX = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var builder = new StringBuilder();

        for (var index = 0; index < values.Count; index++)
        {
            var normalized = max <= 0 ? 0 : (double)(values[index] / max);
            var x = padding + (stepX * index);
            var y = height - padding - (innerHeight * normalized);
            builder.Append(index == 0 ? "M " : " L ");
            builder.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            builder.Append(' ');
            builder.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
        }

        return builder.ToString();
    }

    private string BuildAreaPath(IReadOnlyList<decimal> values, double width, double height, double padding)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var linePath = BuildLinePath(values, width, height, padding);
        var innerWidth = Math.Max(width - (padding * 2), 1);
        var stepX = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);
        var startX = padding;
        var endX = padding + (stepX * (values.Count - 1));
        var baseline = height - padding;

        return $"{linePath} L {endX.ToString("0.##", CultureInfo.InvariantCulture)} {baseline.ToString("0.##", CultureInfo.InvariantCulture)} L {startX.ToString("0.##", CultureInfo.InvariantCulture)} {baseline.ToString("0.##", CultureInfo.InvariantCulture)} Z";
    }

    private IReadOnlyList<(double X, double Y)> BuildPoints(IReadOnlyList<decimal> values, double width, double height, double padding)
    {
        if (values.Count == 0)
        {
            return Array.Empty<(double X, double Y)>();
        }

        var max = values.Max();
        var innerWidth = Math.Max(width - (padding * 2), 1);
        var innerHeight = Math.Max(height - (padding * 2), 1);
        var stepX = values.Count == 1 ? 0 : innerWidth / (values.Count - 1);

        return Enumerable.Range(0, values.Count)
            .Select(index =>
            {
                var normalized = max <= 0 ? 0 : (double)(values[index] / max);
                var x = padding + (stepX * index);
                var y = height - padding - (innerHeight * normalized);
                return (x, y);
            })
            .ToList();
    }

    private string FormatCurrency(decimal amount) => string.Format(new CultureInfo("vi-VN"), "{0:N0} đ", amount);
}

@{
    ViewData["Title"] = "Báo cáo";

    const double chartWidth = 920;
    const double chartHeight = 320;
    const double chartPadding = 34;
    var revenueValues = Model.Summary.RevenueSeries.Select(x => x.Revenue).ToList();
    var revenuePath = BuildLinePath(revenueValues, chartWidth, chartHeight, chartPadding);
    var revenueAreaPath = BuildAreaPath(revenueValues, chartWidth, chartHeight, chartPadding);
    var revenuePoints = BuildPoints(revenueValues, chartWidth, chartHeight, chartPadding);
}

<section class="admin-dashboard admin-report-page">
    <section class="admin-panel admin-report-hero">
        <div class="admin-report-hero__copy">
            <span class="admin-panel__label">Business Intelligence</span>
            <h2>Báo cáo vận hành và doanh thu ChillTour</h2>
        </div>

        <div class="admin-report-hero__actions">
            <a asp-action="ExportReportsExcel"
               asp-route-period="@Model.Filter.Period"
               asp-route-fromDate="@Model.Filter.FromDate"
               asp-route-toDate="@Model.Filter.ToDate"
               asp-route-tourId="@Model.Filter.TourId"
               asp-route-bookingStatus="@Model.Filter.BookingStatus"
               asp-route-paymentStatus="@Model.Filter.PaymentStatus"
               asp-route-paymentMethod="@Model.Filter.PaymentMethod"
               class="btn btn-primary">Export Excel</a>
            <a asp-action="ExportReportsPdf"
               asp-route-period="@Model.Filter.Period"
               asp-route-fromDate="@Model.Filter.FromDate"
               asp-route-toDate="@Model.Filter.ToDate"
               asp-route-tourId="@Model.Filter.TourId"
               asp-route-bookingStatus="@Model.Filter.BookingStatus"
               asp-route-paymentStatus="@Model.Filter.PaymentStatus"
               asp-route-paymentMethod="@Model.Filter.PaymentMethod"
               class="btn btn-light">Export PDF</a>
        </div>
    </section>

    <section class="admin-panel admin-report-filter-panel">
        <div class="admin-panel__header">
            <div>
                <span class="admin-panel__label">Bộ lọc</span>
            </div>
            <div class="admin-report-range">
                <strong>Kỳ báo cáo:</strong>
                <span>@Model.Summary.FromDate.ToString("dd/MM/yyyy") - @Model.Summary.ToDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <form asp-action="Reports" method="get" class="admin-report-filter">
            <label>
                Chu kỳ
                <select asp-for="Filter.Period" asp-items="Model.PeriodOptions" class="form-select"></select>
            </label>
            <label>
                Từ ngày
                <input asp-for="Filter.FromDate" class="form-control" type="date" />
            </label>
            <label>
                Đến ngày
                <input asp-for="Filter.ToDate" class="form-control" type="date" />
            </label>
            <label>
                Tour
                <select asp-for="Filter.TourId" asp-items="Model.TourOptions" class="form-select"></select>
            </label>
            <label>
                Trạng thái đơn
                <select asp-for="Filter.BookingStatus" asp-items="Model.BookingStatusOptions" class="form-select"></select>
            </label>
            <label>
                Trạng thái thanh toán
                <select asp-for="Filter.PaymentStatus" asp-items="Model.PaymentStatusOptions" class="form-select"></select>
            </label>
            <label>
                Phương thức thanh toán
                <select asp-for="Filter.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
            </label>
            <div class="admin-report-filter__actions">
                <button type="submit" class="btn btn-primary">Áp dụng bộ lọc</button>
                <a asp-action="Reports" class="btn btn-light">Đặt lại</a>
            </div>
        </form>
    </section>

    <div class="admin-overview-grid admin-overview-grid--reports">
        <article class="admin-stat-card admin-stat-card--blue">
            <span>Tổng booking</span>
            <strong>@Model.Summary.TotalBookings</strong>
            <p>@Model.Summary.PaidBookings đơn đã ghi nhận thanh toán.</p>
        </article>
        <article class="admin-stat-card">
            <span>Doanh thu đã thu</span>
            <strong>@FormatCurrency(Model.Summary.CollectedRevenue)</strong>
            <p>Dựa trên các giao dịch đã được xác nhận.</p>
        </article>
        <article class="admin-stat-card admin-stat-card--mint">
            <span>Doanh thu còn phải thu</span>
            <strong>@FormatCurrency(Model.Summary.PendingRevenue)</strong>
            <p>Phần công nợ còn lại của các đơn đang mở.</p>
        </article>
        <article class="admin-stat-card admin-stat-card--orange">
            <span>Tỷ lệ hủy đơn</span>
            <strong>@Model.Summary.CancellationRate.ToString("N1")%</strong>
            <p>@Model.Summary.CancelledBookings đơn đã hủy hoặc hoàn tiền.</p>
        </article>
    </div>

    <div class="admin-dashboard-grid admin-dashboard-grid--reports">
        <section class="admin-panel admin-panel--hero admin-report-chart-panel">
            <div class="admin-panel__header">
                <div>
                    <span class="admin-panel__label">Revenue Line</span>
                    <h2>Biểu đồ doanh thu</h2>
                </div>
                <div class="admin-chart-legend">
                    <span><i class="admin-dot admin-dot--blue"></i> Doanh thu</span>
                    <span><i class="admin-dot admin-dot--green"></i> Số booking</span>
                </div>
            </div>

            <div class="admin-line-chart" data-line-chart>
                <svg viewBox="0 0 @chartWidth @chartHeight" preserveAspectRatio="none" role="img" aria-label="Biểu đồ đường doanh thu">
                    <defs>
                        <linearGradient id="reportRevenueFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="rgba(11,116,255,0.35)" />
                            <stop offset="100%" stop-color="rgba(11,116,255,0.04)" />
                        </linearGradient>
                    </defs>

                    @for (var row = 0; row < 5; row++)
                    {
                        var y = chartPadding + ((chartHeight - (chartPadding * 2)) / 4 * row);
                        <line x1="@chartPadding" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="@(chartWidth - chartPadding)" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" class="admin-line-chart__grid" />
                    }

                    @if (revenueValues.Count > 0)
                    {
                        <path d="@revenueAreaPath" class="admin-line-chart__area"></path>
                        <path d="@revenuePath" class="admin-line-chart__line"></path>

                        @for (var index = 0; index < revenuePoints.Count; index++)
                        {
                            var point = revenuePoints[index];
                            <circle cx="@point.X.ToString("0.##", CultureInfo.InvariantCulture)"
                                    cy="@point.Y.ToString("0.##", CultureInfo.InvariantCulture)"
                                    r="5.4"
                                    class="admin-line-chart__point">
                                <title>@Model.Summary.RevenueSeries.ElementAt(index).Label - @FormatCurrency(Model.Summary.RevenueSeries.ElementAt(index).Revenue)</title>
                            </circle>
                        }
                    }
                </svg>

                <div class="admin-line-chart__labels">
                    @foreach (var point in Model.Summary.RevenueSeries)
                    {
                        <div>
                            <strong>@point.Label</strong>
                            <span>@point.BookingCount booking</span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="admin-side-stats admin-report-kpis">
            <article class="admin-mini-card">
                <span>Khách mới</span>
                <strong>@Model.Summary.NewCustomers</strong>
                <p>Số khách đăng ký mới trong kỳ đang xem.</p>
            </article>
            <article class="admin-mini-card admin-mini-card--green">
                <span>Khách quay lại</span>
                <strong>@Model.Summary.ReturningCustomers</strong>
                <p>Khách có từ 2 booking trở lên trong cùng kỳ.</p>
            </article>
            <article class="admin-mini-card admin-mini-card--orange">
                <span>Đánh giá trung bình</span>
                <strong>@Model.Summary.AverageRating.ToString("N1")/5</strong>
                <p>@Model.Summary.ReviewCount đánh giá đã được duyệt.</p>
            </article>
            <article class="admin-mini-card">
                <span>Việc cần xử lý</span>
                <strong>@Model.Summary.PendingStaffTasks</strong>
                <p>Tổng số tác vụ chờ finance hoặc staff xử lý.</p>
            </article>
        </section>
    </div>

    <div class="admin-lower-grid admin-lower-grid--reports">
        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <span class="admin-panel__label">Breakdown</span>
                    <h2>Trạng thái booking</h2>
                </div>
            </div>

            <div class="admin-report-breakdown">
                @if (Model.Summary.BookingStatusBreakdown.Count == 0)
                {
                    <p class="admin-empty-state">Không có dữ liệu booking trong kỳ đã lọc.</p>
                }
                else
                {
                    @foreach (var item in Model.Summary.BookingStatusBreakdown)
                    {
                        <article class="admin-report-breakdown__item">
                            <div class="admin-report-breakdown__copy">
                                <strong>@item.Label</strong>
                                <p>@item.Count đơn • @FormatCurrency(item.Amount)</p>
                            </div>
                            <div class="admin-report-breakdown__meter">
                                <span style="width:@item.Percent%"></span>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <span class="admin-panel__label">Finance</span>
                    <h2>Thanh toán và phương thức</h2>
                </div>
            </div>

            <div class="admin-report-breakdown">
                @if (Model.Summary.PaymentStatusBreakdown.Count == 0)
                {
                    <p class="admin-empty-state">Không có giao dịch phù hợp với bộ lọc hiện tại.</p>
                }
                else
                {
                    @foreach (var item in Model.Summary.PaymentStatusBreakdown)
                    {
                        <article class="admin-report-breakdown__item">
                            <div class="admin-report-breakdown__copy">
                                <strong>@item.Label</strong>
                                <p>@item.Count giao dịch • @FormatCurrency(item.Amount)</p>
                            </div>
                            <div class="admin-report-breakdown__meter">
                                <span class="is-green" style="width:@item.Percent%"></span>
                            </div>
                        </article>
                    }
                }
            </div>

            <div class="admin-report-tags">
                @foreach (var item in Model.Summary.PaymentMethodBreakdown)
                {
                    <span class="admin-status-pill admin-status-pill--info">@item.Label: @FormatCurrency(item.Amount)</span>
                }
            </div>
        </section>
    </div>

    <div class="admin-lower-grid admin-lower-grid--reports">
        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <span class="admin-panel__label">Top tours</span>
                    <h2>Tour nổi bật theo hiệu quả kinh doanh</h2>
                </div>
            </div>

            <div class="admin-rank-list">
                @if (Model.Summary.TopTours.Count == 0)
                {
                    <p class="admin-empty-state">Chưa có tour phát sinh dữ liệu trong kỳ lọc.</p>
                }
                else
                {
                    @for (var index = 0; index < Model.Summary.TopTours.Count; index++)
                    {
                        var item = Model.Summary.TopTours.ElementAt(index);
                        <article class="admin-rank-item">
                            <span>@(index + 1)</span>
                            <div>
                                <strong>@item.TourName</strong>
                                <p>@item.TourCode • @item.BookingCount booking • @FormatCurrency(item.Revenue)</p>
                            </div>
                            <small>★ @item.Rating.ToString("N1") • Hủy @item.CancelledBookings</small>
                        </article>
                    }
                }
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <span class="admin-panel__label">Task board</span>
                    <h2>Các việc nội bộ cần xử lý</h2>
                </div>
            </div>

            <div class="admin-report-task-grid">
                @foreach (var task in Model.Summary.StaffTasks)
                {
                    <article class="admin-mini-card">
                        <span>@task.Label</span>
                        <strong>@task.Count</strong>
                        <p>@task.Hint</p>
                    </article>
                }
            </div>
        </section>
    </div>

    <section class="admin-panel">
        <div class="admin-panel__header">
            <div>
                <span class="admin-panel__label">Recent payments</span>
                <h2>Giao dịch gần đây</h2>
            </div>
        </div>

        <div class="admin-dashboard-table">
            @if (Model.Summary.RecentTransactions.Count == 0)
            {
                <p class="admin-empty-state">Không có giao dịch trong kỳ báo cáo này.</p>
            }
            else
            {
                @foreach (var item in Model.Summary.RecentTransactions)
                {
                    <article class="admin-dashboard-row">
                        <div>
                            <strong>@item.PaymentCode</strong>
                            <p>@item.BookingCode • @item.CustomerName</p>
                        </div>
                        <div>
                            <span>@FormatCurrency(item.Amount)</span>
                            <p>@item.PaymentMethodLabel</p>
                        </div>
                        <div class="admin-dashboard-row__status">
                            <span class="admin-status-pill admin-status-pill--info">@item.PaymentStatusLabel</span>
                            <small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/pages/admin/charts.js" asp-append-version="true"></script>
}
