@model ChillTour.Models.Admin.EmployeeOrdersViewModel
@using ChillTour.Security
@{
    ViewData["Title"] = "Xử lý đơn";
    var canManageBookings = RoleConstants.ManageBookings.Any(User.IsInRole);
    var canManageFinance = RoleConstants.ManageFinance.Any(User.IsInRole);
    var canEditBookingStatus = canManageBookings;
    var firstItem = Model.TotalItems == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var lastItem = Model.TotalItems == 0 ? 0 : Math.Min(firstItem + Model.Bookings.Count - 1, Model.TotalItems);
}

<section class="admin-page-stack admin-orders-page">
    <div class="admin-page-head admin-orders-hero">
        <div>
            <span class="admin-panel__label">Operations</span>
            <h2>Xử lý đơn đặt tour</h2>
            <p>Theo dõi thanh toán, xác nhận booking và cập nhật trạng thái vận hành tour.</p>
        </div>
        <button type="button" class="btn btn-outline-primary admin-orders-rule-btn" data-bs-toggle="modal" data-bs-target="#orderRulesModal">
            Quy tắc xử lý đơn
        </button>
    </div>

    @if (TempData["AdminSuccessMessage"] is string successMessage)
    {
        <div class="auth-alert auth-alert--success">@successMessage</div>
    }
    @if (TempData["AdminErrorMessage"] is string errorMessage)
    {
        <div class="auth-alert auth-alert--error">@errorMessage</div>
    }

    <div class="admin-metrics admin-orders-metrics">
        <div class="admin-stat-card admin-order-stat admin-order-stat--blue">
            <div class="admin-order-stat__icon" aria-hidden="true">P</div>
            <span>Đơn chờ xử lý</span>
            <strong>@Model.PendingOrders</strong>
            <p>Bao gồm đơn chờ thanh toán hoặc cần Staff xử lý.</p>
            <i aria-hidden="true"></i>
        </div>
        <div class="admin-stat-card admin-order-stat admin-order-stat--green">
            <div class="admin-order-stat__icon" aria-hidden="true">C</div>
            <span>Đơn đã xác nhận</span>
            <strong>@Model.ConfirmedOrders</strong>
            <p>Đang vận hành hoặc đã hoàn tất.</p>
            <i aria-hidden="true"></i>
        </div>
        <div class="admin-stat-card admin-order-stat admin-order-stat--orange">
            <div class="admin-order-stat__icon" aria-hidden="true">R</div>
            <span>Đơn hủy/hoàn tiền</span>
            <strong>@Model.CancelledOrders</strong>
            <p>Các đơn đã đóng hoặc hủy.</p>
            <i aria-hidden="true"></i>
        </div>
    </div>

    <section class="admin-panel admin-orders-panel">
        <div class="admin-panel__header">
            <div>
                <span class="admin-panel__label">Bookings</span>
                <h2>Danh sách đơn</h2>
            </div>
            <div class="admin-orders-count">@Model.TotalItems đơn</div>
        </div>

        <form method="get" class="admin-orders-filter mb-4">
            <input type="hidden" name="page" value="1" />
            <label>
                Từ khóa
                <input type="text" name="searchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Mã đơn, khách hàng, tour..." />
            </label>
            <label>
                Trạng thái đơn
                <select name="bookingStatus" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var status in FilterStatusOptions())
                    {
                        <option value="@status" selected="@(Model.Filter.BookingStatus == status)">@StatusLabel(status)</option>
                    }
                </select>
            </label>
            <label>
                Trạng thái thanh toán
                <select name="paymentStatus" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="0" selected="@(Model.Filter.PaymentStatus == 0)">Chưa thanh toán</option>
                    <option value="1" selected="@(Model.Filter.PaymentStatus == 1)">Đã ghi nhận giao dịch</option>
                    <option value="2" selected="@(Model.Filter.PaymentStatus == 2)">Đã cọc</option>
                    <option value="3" selected="@(Model.Filter.PaymentStatus == 3)">Đã thanh toán đủ</option>
                    <option value="4" selected="@(Model.Filter.PaymentStatus == 4)">Thanh toán lỗi</option>
                </select>
            </label>
            <label>
                Từ ngày khởi hành
                <input type="date" name="departureFrom" value="@(Model.Filter.DepartureFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </label>
            <label>
                Đến ngày khởi hành
                <input type="date" name="departureTo" value="@(Model.Filter.DepartureTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </label>
            <div class="admin-orders-filter__actions">
                <button type="submit" class="btn btn-primary">Lọc đơn</button>
                <a asp-action="Orders" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>

        <div class="table-responsive admin-orders-table-wrap">
            <table class="table align-middle admin-orders-table admin-orders-polished-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Tour</th>
                        <th>Khởi hành</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bookings.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">Không có đơn phù hợp với bộ lọc hiện tại.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td>
                                    <strong>@booking.BookingCode</strong>
                                    <div class="text-muted small">@booking.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <strong>@booking.CustomerName</strong>
                                    <div class="text-muted small">@booking.ContactPhone</div>
                                </td>
                                <td class="admin-orders-table__tour">
                                    <strong title="@booking.TourName">@booking.TourName</strong>
                                    <div class="text-muted small">@booking.TourCode</div>
                                </td>
                                <td>@booking.DepartureDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <strong>@booking.TotalAmount.ToString("N0") đ</strong>
                                    <div class="text-muted small">Đã trả: @booking.PaidAmount.ToString("N0") đ</div>
                                    <div class="text-muted small">Còn lại: @booking.RemainingAmount.ToString("N0") đ</div>
                                </td>
                                <td>
                                    <span class="status-pill admin-orders-status @StatusClass(booking.BookingStatus, booking.IsCompletedByDeparture)">
                                        <i aria-hidden="true"></i>
                                        @booking.BookingStatusText
                                    </span>
                                </td>
                                <td>
                                    @if (canEditBookingStatus && !booking.IsStatusLocked)
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editOrderStatusModal"
                                                data-booking-id="@booking.BookingId"
                                                data-booking-code="@booking.BookingCode"
                                                data-booking-status="@booking.BookingStatus">
                                            Sửa
                                        </button>
                                    }
                                    else if (booking.IsStatusLocked)
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-locked-edit
                                                data-locked-reason="@(booking.IsCompletedByDeparture ? "Đơn đã quá ngày khởi hành nên được xem là đã hoàn thành và không thể sửa." : $"Đơn {booking.BookingStatusText.ToLower()} nên không thể sửa trạng thái.")">
                                            Sửa
                                        </button>
                                    }
                                    @if (booking.HasPaymentToVerify && canManageFinance && booking.LatestPaymentId.HasValue)
                                    {
                                        <form asp-action="VerifyPayment" method="post" class="admin-row-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="paymentId" value="@booking.LatestPaymentId" />
                                            <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                            <button type="submit" name="isValid" value="true" class="btn btn-success btn-sm">Xác nhận tiền</button>
                                            <button type="submit" name="isValid" value="false" class="btn btn-outline-danger btn-sm" onclick="return confirm('Từ chối giao dịch này?');">Sai giao dịch</button>
                                        </form>
                                    }
                                    @if (booking.BookingStatus == 10 && canManageFinance)
                                    {
                                        <form asp-action="CompleteRefund" method="post" class="admin-row-action-form" onsubmit="return confirm('Xác nhận đã hoàn tiền cho đơn này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                            <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                            <button type="submit" class="btn btn-success btn-sm">Đã hoàn tiền</button>
                                        </form>
                                    }
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#orderDetailModal"
                                            data-booking-code="@booking.BookingCode"
                                            data-customer-name="@booking.CustomerName"
                                            data-contact-name="@booking.ContactName"
                                            data-contact-email="@booking.ContactEmail"
                                            data-contact-phone="@booking.ContactPhone"
                                            data-tour-name="@booking.TourName"
                                            data-tour-code="@booking.TourCode"
                                            data-departure-date="@booking.DepartureDate.ToString("dd/MM/yyyy")"
                                            data-return-date="@booking.ReturnDate.ToString("dd/MM/yyyy")"
                                            data-adult-count="@booking.AdultCount"
                                            data-child-count="@booking.ChildCount"
                                            data-infant-count="@booking.InfantCount"
                                            data-travelers="@booking.Travelers"
                                            data-total-amount="@booking.TotalAmount.ToString("N0") đ"
                                            data-paid-amount="@booking.PaidAmount.ToString("N0") đ"
                                            data-remaining-amount="@booking.RemainingAmount.ToString("N0") đ"
                                            data-booking-status="@booking.BookingStatusText"
                                            data-payment-code="@booking.LatestPaymentCode"
                                            data-payment-transaction="@booking.LatestPaymentTransactionReference"
                                            data-payment-confirmed-by="@(string.IsNullOrWhiteSpace(booking.PaymentConfirmedByName) ? "Chưa có log" : booking.PaymentConfirmedByName)"
                                            data-payment-confirmed-at="@(booking.PaymentConfirmedAt.HasValue ? booking.PaymentConfirmedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa có log")"
                                            data-booking-confirmed-by="@(string.IsNullOrWhiteSpace(booking.BookingConfirmedByName) ? "Chưa có log" : booking.BookingConfirmedByName)"
                                            data-booking-confirmed-at="@(booking.BookingConfirmedAt.HasValue ? booking.BookingConfirmedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa có log")"
                                            data-special-requests="@(string.IsNullOrWhiteSpace(booking.SpecialRequests) ? "Không có" : booking.SpecialRequests)">
                                        Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-orders-footer">
            <span>Hiển thị @firstItem - @lastItem trong tổng số @Model.TotalItems đơn</span>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang đơn">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="Orders" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-bookingStatus="@Model.Filter.BookingStatus" asp-route-paymentStatus="@Model.Filter.PaymentStatus" asp-route-departureFrom="@(Model.Filter.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.Filter.DepartureTo?.ToString("yyyy-MM-dd"))">Trước</a>
                    </li>
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                            <a class="page-link" asp-action="Orders" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-bookingStatus="@Model.Filter.BookingStatus" asp-route-paymentStatus="@Model.Filter.PaymentStatus" asp-route-departureFrom="@(Model.Filter.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.Filter.DepartureTo?.ToString("yyyy-MM-dd"))">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="Orders" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.Filter.SearchTerm" asp-route-bookingStatus="@Model.Filter.BookingStatus" asp-route-paymentStatus="@Model.Filter.PaymentStatus" asp-route-departureFrom="@(Model.Filter.DepartureFrom?.ToString("yyyy-MM-dd"))" asp-route-departureTo="@(Model.Filter.DepartureTo?.ToString("yyyy-MM-dd"))">Sau</a>
                    </li>
                </ul>
                </nav>
            }
        </div>
    </section>
</section>

<div class="modal fade" id="orderRulesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quy tắc xử lý đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <ol class="admin-rule-list">
                    <li><strong>Khách chuyển tiền thành công:</strong> hệ thống chỉ chuyển đơn sang <b>Chờ xác nhận</b>. Chưa cộng doanh thu và chưa xem là đã cọc.</li>
                    <li><strong>Nhân viên kiểm tra giao dịch:</strong> đối chiếu số tiền, mã thanh toán và nội dung chuyển khoản. Nếu hợp lệ, cập nhật đơn thành <b>Đã cọc</b> hoặc <b>Đã thanh toán đầy đủ</b>.</li>
                    <li><strong>Nhân viên liên hệ khách:</strong> xác nhận thông tin khách, số lượng người đi, yêu cầu đặc biệt và lịch khởi hành.</li>
                    <li><strong>Hoàn tất giữ chỗ:</strong> sau khi đã liên hệ khách, cập nhật đơn thành <b>Đã đặt</b>. Lúc này hệ thống tạo hợp đồng và thông báo Giám đốc ký.</li>
                    <li><strong>Đơn quá ngày khởi hành:</strong> hệ thống hiển thị là <b>Đã hoàn thành</b> và không cho sửa trạng thái.</li>
                    <li><strong>Đơn đã hủy hoặc đã hoàn tiền:</strong> trạng thái bị khóa, không thể sửa lại trên trang xử lý đơn.</li>
                    <li><strong>Hoàn tiền:</strong> đơn yêu cầu hoàn tiền cần được chuyển sang chờ hoàn tiền, sau đó quản lý xác nhận đã hoàn tiền.</li>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editOrderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UpdateOrderStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editStatusBookingId" name="BookingId" />
                <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
                <div class="modal-header">
                    <h5 class="modal-title">Sửa trạng thái đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p id="editStatusBookingCode" class="text-muted mb-3"></p>
                    <label class="w-100">
                        Trạng thái mới
                        <select id="editStatusValue" name="BookingStatus" class="form-select">
                            @foreach (var status in EditableStatusOptions())
                            {
                                <option value="@status">@StatusLabel(status)</option>
                            }
                        </select>
                    </label>
                    <label class="w-100 mt-3">
                        Ghi chú
                        <textarea name="Notes" class="form-control admin-textarea" maxlength="500" placeholder="Nhập lý do hoặc ghi chú xử lý..."></textarea>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu trạng thái</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="lockedOrderToast" class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" data-locked-toast-message>Không thể sửa trạng thái đơn này.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>

<div class="modal fade admin-order-detail-modal" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content admin-order-detail">
            <div class="modal-header">
                <div>
                    <span class="admin-panel__label">Booking detail</span>
                    <h5 class="modal-title">Chi tiết đơn</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="admin-order-detail-grid">
                    <label>
                        Mã đơn
                        <input id="detailBookingCode" class="form-control" readonly />
                    </label>
                    <label>
                        Trạng thái
                        <input id="detailBookingStatus" class="form-control" readonly />
                    </label>
                </div>

                <div class="admin-order-detail-section">
                    <h6>Khách hàng</h6>
                    <div class="admin-order-detail-grid">
                    <label>
                        Khách hàng
                        <input id="detailCustomerName" class="form-control" readonly />
                    </label>
                    <label>
                        Người liên hệ
                        <input id="detailContactName" class="form-control" readonly />
                    </label>
                    <label>
                        Email liên hệ
                        <input id="detailContactEmail" class="form-control" readonly />
                    </label>
                    <label>
                        Số điện thoại
                        <input id="detailContactPhone" class="form-control" readonly />
                    </label>
                    </div>
                </div>

                <div class="admin-order-detail-section">
                    <h6>Thông tin tour</h6>
                    <div class="admin-order-detail-grid">
                    <label>
                        Tour
                        <input id="detailTourName" class="form-control" readonly />
                    </label>
                    <label>
                        Mã tour
                        <input id="detailTourCode" class="form-control" readonly />
                    </label>
                    <label>
                        Khởi hành
                        <input id="detailDepartureDate" class="form-control" readonly />
                    </label>
                    <label>
                        Kết thúc
                        <input id="detailReturnDate" class="form-control" readonly />
                    </label>
                    <label>
                        Số lượng khách
                        <input id="detailTravelers" class="form-control" readonly />
                    </label>
                    </div>
                </div>

                <div class="admin-order-detail-section admin-order-detail-section--finance">
                    <h6>Thanh toán</h6>
                    <div class="admin-order-detail-grid">
                    <label>
                        Tổng tiền
                        <input id="detailTotalAmount" class="form-control" readonly />
                    </label>
                    <label>
                        Đã thanh toán
                        <input id="detailPaidAmount" class="form-control" readonly />
                    </label>
                    <label>
                        Còn lại
                        <input id="detailRemainingAmount" class="form-control" readonly />
                    </label>
                    <label>
                        Mã thanh toán
                        <input id="detailPaymentCode" class="form-control" readonly />
                    </label>
                    <label>
                        Mã giao dịch VNPay
                        <input id="detailPaymentTransaction" class="form-control" readonly />
                    </label>
                    <label>
                        Ghi nhận thanh toán
                        <input id="detailPaymentConfirmedBy" class="form-control" readonly />
                    </label>
                    <label>
                        Thời điểm xác nhận tiền
                        <input id="detailPaymentConfirmedAt" class="form-control" readonly />
                    </label>
                    <label>
                        Staff xác nhận booking
                        <input id="detailBookingConfirmedBy" class="form-control" readonly />
                    </label>
                    <label>
                        Thời điểm xác nhận booking
                        <input id="detailBookingConfirmedAt" class="form-control" readonly />
                    </label>
                    </div>
                </div>

                <label class="admin-order-detail-note">
                    Yêu cầu đặc biệt
                    <textarea id="detailSpecialRequests" class="form-control admin-textarea" readonly></textarea>
                </label>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const modal = document.getElementById('editOrderStatusModal');
        if (!modal) {
            return;
        }

        modal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            document.getElementById('editStatusBookingId').value = button.getAttribute('data-booking-id') || '';
            document.getElementById('editStatusValue').value = button.getAttribute('data-booking-status') || '0';
            document.getElementById('editStatusBookingCode').textContent = `Đơn ${button.getAttribute('data-booking-code') || ''}`;
        });
    })();

    (() => {
        const modal = document.getElementById('orderDetailModal');
        if (!modal) {
            return;
        }

        modal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            if (!button) {
                return;
            }

            const travelers = `${button.getAttribute('data-travelers')} khách (${button.getAttribute('data-adult-count')} NL, ${button.getAttribute('data-child-count')} TE, ${button.getAttribute('data-infant-count')} EB)`;

            document.getElementById('detailBookingCode').value = button.getAttribute('data-booking-code') || '';
            document.getElementById('detailBookingStatus').value = button.getAttribute('data-booking-status') || '';
            document.getElementById('detailCustomerName').value = button.getAttribute('data-customer-name') || '';
            document.getElementById('detailContactName').value = button.getAttribute('data-contact-name') || '';
            document.getElementById('detailContactEmail').value = button.getAttribute('data-contact-email') || '';
            document.getElementById('detailContactPhone').value = button.getAttribute('data-contact-phone') || '';
            document.getElementById('detailTourName').value = button.getAttribute('data-tour-name') || '';
            document.getElementById('detailTourCode').value = button.getAttribute('data-tour-code') || '';
            document.getElementById('detailDepartureDate').value = button.getAttribute('data-departure-date') || '';
            document.getElementById('detailReturnDate').value = button.getAttribute('data-return-date') || '';
            document.getElementById('detailTravelers').value = travelers;
            document.getElementById('detailTotalAmount').value = button.getAttribute('data-total-amount') || '';
            document.getElementById('detailPaidAmount').value = button.getAttribute('data-paid-amount') || '';
            document.getElementById('detailRemainingAmount').value = button.getAttribute('data-remaining-amount') || '';
            document.getElementById('detailPaymentCode').value = button.getAttribute('data-payment-code') || '';
            document.getElementById('detailPaymentTransaction').value = button.getAttribute('data-payment-transaction') || '';
            document.getElementById('detailPaymentConfirmedBy').value = button.getAttribute('data-payment-confirmed-by') || '';
            document.getElementById('detailPaymentConfirmedAt').value = button.getAttribute('data-payment-confirmed-at') || '';
            document.getElementById('detailBookingConfirmedBy').value = button.getAttribute('data-booking-confirmed-by') || '';
            document.getElementById('detailBookingConfirmedAt').value = button.getAttribute('data-booking-confirmed-at') || '';
            document.getElementById('detailSpecialRequests').value = button.getAttribute('data-special-requests') || '';
        });
    })();

    (() => {
        const toastElement = document.getElementById('lockedOrderToast');
        if (!toastElement || !window.bootstrap) {
            return;
        }

        const toast = bootstrap.Toast.getOrCreateInstance(toastElement);
        const message = toastElement.querySelector('[data-locked-toast-message]');

        document.querySelectorAll('[data-locked-edit]').forEach(button => {
            button.addEventListener('click', () => {
                message.textContent = button.getAttribute('data-locked-reason') || 'Không thể sửa trạng thái đơn này.';
                toast.show();
            });
        });
    })();
</script>
}

@functions {
    private static int[] FilterStatusOptions() => [1, 2, 8, 3, 4, 5, 9, 10];

    private static int[] EditableStatusOptions() => [2, 8, 3, 4, 9, 10, 5];

    private static string StatusLabel(int status) => status switch
    {
        0 => "Chờ thanh toán",
        1 => "Chờ xác nhận",
        2 => "Đã cọc",
        3 => "Đã đặt",
        4 => "Đã hủy",
        5 => "Đã hoàn tiền",
        6 => "Chờ thanh toán còn lại",
        7 => "Chờ xác nhận",
        8 => "Đã thanh toán đầy đủ",
        9 => "Yêu cầu hoàn tiền",
        10 => "Chờ hoàn tiền",
        _ => "Không xác định"
    };

    private static string StatusClass(int status, bool isCompleted = false) => isCompleted ? "status-pill--success" : status switch
    {
        2 or 3 or 8 => "status-pill--success",
        4 or 5 => "status-pill--danger",
        1 or 6 or 7 or 9 or 10 => "status-pill--info",
        _ => "status-pill--warning"
    };
}
